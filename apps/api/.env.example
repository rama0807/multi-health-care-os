# Application
NODE_ENV=development
PORT=4000
APP_NAME=MediCore API
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://medicore:medicore@localhost:5432/medicore_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (RS256 — generate a dev keypair with `pnpm --filter @medicore/api keys:generate`)
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cookies / CSRF
COOKIE_SECRET=change-me-in-production-min-32-chars

# Throttle (rate limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@medicore.app
EMAIL_FROM_NAME=MediCore

# Object Storage — STORAGE_PROVIDER is "local" (default, writes under
# LOCAL_STORAGE_PATH and serves via the API's own /uploads route) or "s3"
# (AWS S3 or any S3-compatible endpoint, e.g. the MinIO container below).
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# AWS S3 / MinIO (Object Storage) — only used when STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=medicore-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/medicore-dev

# AI Providers
OPENAI_API_KEY=sk-xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
AI_PROVIDER=openai
AI_MODEL=gpt-4o

# Logging
LOG_LEVEL=debug

# Sentry (production error tracking)
SENTRY_DSN=
