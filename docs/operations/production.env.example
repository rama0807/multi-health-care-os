# MediCore production environment (Milestone 19.5).
# Copy to .env.production, fill in, `chmod 600`. Never commit the filled copy.
#
# `apps/api/src/config/env.validation.ts` is the authority on what is required;
# the API refuses to start rather than run unsafely.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=medicore
POSTGRES_PASSWORD=            # openssl rand -base64 32
POSTGRES_DB=medicore
DATABASE_URL=postgresql://medicore:<password>@postgres:5432/medicore?schema=public

# ── Redis (sessions, rate limiting, cache) ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=               # openssl rand -base64 32

# ── Auth ────────────────────────────────────────────────────────────────────
# pnpm --filter @medicore/api keys:generate
JWT_PRIVATE_KEY=              # base64-encoded PKCS#8 PEM
JWT_PUBLIC_KEY=               # base64-encoded SPKI PEM
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d
COOKIE_SECRET=                # openssl rand -base64 48 — min 32 chars, boot fails otherwise

# ── HTTP ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://medicore.example.com
CORS_ORIGINS=                 # optional, comma-separated; overrides FRONTEND_URL
NEXT_PUBLIC_API_URL=https://medicore.example.com/api
TRUST_PROXY=true              # true only when behind a proxy you control
SWAGGER_ENABLED=false

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
METRICS_TOKEN=                # openssl rand -hex 32 — unset means /api/metrics 404s
DB_SLOW_QUERY_MS=300
SHUTDOWN_DRAIN_MS=5000

# ── Rate limiting ───────────────────────────────────────────────────────────
# Both tiers are per-IP, and a hospital LAN arrives NAT'd behind one address.
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=20
THROTTLE_AUTH_TTL_SECONDS=60

# ── Storage — S3/MinIO, or clinical documents die with the container ────────
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@medicore.example.com

# ── Optional integrations (each fails closed and says so when unset) ────────
# SMS_DRIVER / WHATSAPP_DRIVER: never LOG in production — it writes message
# bodies to the application log. See TD-0059.
# FCM_*: browser push. See TD-0058.
# AI_ENABLED / AI_PROVIDER: confirm a BAA before enabling a third-party
# provider; AI_PROVIDER=OLLAMA keeps clinical context inside the deployment.
# See TD-0042.
