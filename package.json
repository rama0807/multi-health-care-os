{
  "name": "medicore",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Hospital Management System",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @medicore/database db:generate",
    "db:migrate": "pnpm --filter @medicore/database db:migrate",
    "db:migrate:dev": "pnpm --filter @medicore/database db:migrate:dev",
    "db:push": "pnpm --filter @medicore/database db:push",
    "db:seed": "pnpm --filter @medicore/database db:seed",
    "db:studio": "pnpm --filter @medicore/database db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.1.4",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2"
  },
  "packageManager": "pnpm@9.15.0"
}
