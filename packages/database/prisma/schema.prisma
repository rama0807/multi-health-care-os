// ─── Core Tenant Model ─────────────────────────────────────────────────────

model Organization {
  id                    String             @id @default(cuid())
  name                  String
  slug                  String             @unique
  type                  OrganizationType   @default(HOSPITAL)
  email                 String
  phone                 String
  address               String?
  city                  String?
  state                 String?
  country               String             @default("IN")
  pincode               String?
  logo                  String?
  website               String?
  licenseNumber         String?
  taxId                 String?
  settings              Json               @default("{}")
  /// Visual identity (theme colours, login background, email header). Kept
  /// separate from `settings` so a branding change never risks clobbering
  /// the operational settings blob every clinical module already reads.
  branding              Json               @default("{}")
  /// True for the single internal tenant that owns the platform. Platform
  /// Owner console access requires this AND a `platform.*` permission -
  /// see `PlatformGuard` (ADR-0025).
  isPlatform            Boolean            @default(false)
  status                OrganizationStatus @default(ACTIVE)
  suspendedAt           DateTime?
  suspensionReason      String?
  subscriptionTier      SubscriptionTier   @default(FREE)
  subscriptionExpiresAt DateTime?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users                     User[]
  roles                     Role[]
  hospitals                 Hospital[]
  departments               Department[]
  doctors                   Doctor[]
  patients                  Patient[]
  appointments              Appointment[]
  encounters                Encounter[]
  labTests                  LabTest[]
  labTestCatalogItems       LabTestCatalogItem[]
  radiologyOrders           RadiologyOrder[]
  radiologyCatalogItems     RadiologyCatalogItem[]
  invoices                  Invoice[]
  serviceCatalogItems       ServiceCatalogItem[]
  charges                   Charge[]
  refunds                   Refund[]
  staff                     Staff[]
  beds                      Bed[]
  wards                     Ward[]
  rooms                     Room[]
  bedAllocations            BedAllocation[]
  bedTransfers              BedTransfer[]
  drugs                     Drug[]
  dispenseOrders            DispenseOrder[]
  drugReturns               DrugReturn[]
  inventoryItems            InventoryItem[]
  inventoryCategories       InventoryCategory[]
  inventoryItemGroups       InventoryItemGroup[]
  inventoryUnits            InventoryUnit[]
  inventoryManufacturers    InventoryManufacturer[]
  inventoryBrands           InventoryBrand[]
  inventoryStores           InventoryStore[]
  inventoryStoreManagers    InventoryStoreManager[]
  vendors                   Vendor[]
  vendorRatings             VendorRating[]
  inventoryStocks           InventoryStock[]
  inventoryBatches          InventoryBatch[]
  inventoryStockAdjustments InventoryStockAdjustment[]
  inventoryStockTransfers   InventoryStockTransfer[]
  purchaseRequests          PurchaseRequest[]
  purchaseOrders            PurchaseOrder[]
  goodsReceiptNotes         GoodsReceiptNote[]
  vendorInvoices            VendorInvoice[]
  vendorReturns             VendorReturn[]
  storeRequisitions         StoreRequisition[]
  assets                    Asset[]
  assetMaintenanceRecords   AssetMaintenanceRecord[]
  assetAssignments          AssetAssignment[]
  stockAudits               StockAudit[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  prescriptions             Prescription[]
  admissions                Admission[]
  insuranceClaims           InsuranceClaim[]
  insuranceProviders        InsuranceProvider[]
  insurancePlans            InsurancePlan[]
  patientInsurances         PatientInsurance[]
  preAuthorizations         PreAuthorization[]
  doctorSchedules           DoctorSchedule[]
  doctorLeaves              DoctorLeave[]
  nursingNotes              NursingNote[]
  nursingAssessments        NursingAssessment[]
  intakeOutputRecords       IntakeOutputRecord[]
  ipdOrders                 IpdOrder[]
  nursingTasks              NursingTask[]
  medicationAdministrations MedicationAdministration[]
  dischargeChecklistItems   DischargeChecklistItem[]
  dischargeSummaries        DischargeSummary[]
  staffDocuments            StaffDocument[]
  shifts                    Shift[]
  shiftRosters              ShiftRoster[]
  attendanceRecords         Attendance[]
  holidays                  Holiday[]
  leaveTypeConfigs          LeaveTypeConfig[]
  staffLeaves               StaffLeave[]
  aiConversations           AiConversation[]
  aiUsageLogs               AiUsageLog[]
  aiPromptTemplates         AiPromptTemplate[]
  savedReports              SavedReport[]
  notificationDeliveries    NotificationDelivery[]
  notificationTemplates     NotificationTemplate[]
  notificationPreferences   NotificationPreference[]
  userDevices               UserDevice[]
  subscription              Subscription?
  emailConfig               OrganizationEmailConfig?

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

/// A tenant's own Resend credential, so it is not forced to share the
/// platform's single `RESEND_API_KEY` (TD-0064). The key is never stored in
/// the clear - `apiKeyCiphertext`/`apiKeyIv`/`apiKeyAuthTag` are AES-256-GCM
/// output from `SecretEncryptionService`; `apiKeyLast4` exists only so the
/// dashboard can show "•••• re42" without ever decrypting for display.
/// One row per organization, created on first save - absence of a row means
/// "use the platform default," not "misconfigured."
model OrganizationEmailConfig {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  apiKeyCiphertext String?
  apiKeyIv         String?
  apiKeyAuthTag    String?
  apiKeyLast4      String?
  fromName         String?
  fromEmail        String?
  replyToEmail     String?
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_email_configs")
}

/// One current subscription per organization (`organizationId` is unique).
/// Plan *changes* are not kept as rows here - every mutation is recorded by
/// the existing `AuditService`, which already stores `before`/`after`
/// snapshots, so a separate history table would duplicate that trail.
model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  plan           SubscriptionTier   @default(FREE)
  status         SubscriptionStatus @default(TRIALING)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  /// Null on any limit means "unlimited" - enforced at the application layer
  /// by `SubscriptionLimitsService`, not by a DB constraint, because the
  /// limit must be checked before a create rather than after it fails.
  maxHospitals   Int?
  maxUsers       Int?
  maxPatients    Int?
  storageQuotaMb Int?
  monthlyPrice   Decimal?           @db.Decimal(12, 2)
  currency       String             @default("INR")
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

// ─── Identity & Access ─────────────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatar              String?
  status              UserStatus @default(PENDING_VERIFICATION)
  isEmailVerified     Boolean    @default(false)
  timezone            String     @default("Asia/Kolkata")
  mfaEnabled          Boolean    @default(false)
  mfaSecret           String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  organizationId      String
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id])
  userRoles              UserRole[]
  doctorProfile          Doctor?
  staffProfile           Staff?
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  devices                UserDevice[]
  aiUsageLogs            AiUsageLog[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id             String      @id @default(cuid())
  name           String
  description    String?
  systemRole     SystemRole?
  organizationId String
  createdAt      DateTime    @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  scope       String  @default("all")
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  hospitalId String?
  assignedAt DateTime @default(now())
  assignedBy String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([hospitalId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

