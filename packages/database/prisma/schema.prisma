generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  NURSING_HOME
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

/// Lifecycle of a tenant, controlled from the Platform Owner console
/// (Milestone 16 / ADR-0025). Deliberately distinct from
/// `Organization.isActive`, which stays the single hard switch every existing
/// auth path already checks (`JwtStrategy.validate`, `AuthService.login`,
/// `AuthService.refresh`) - suspending or cancelling an organization sets
/// `isActive = false` alongside this status rather than introducing a second,
/// parallel enforcement point that could drift out of sync.
enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Billing state of an organization's subscription. Kept separate from
/// `OrganizationStatus` because a tenant can be commercially PAST_DUE while
/// still operationally ACTIVE - only an explicit platform-owner suspension
/// stops logins.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

