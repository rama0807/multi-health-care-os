  REJECTED
  SETTLED
}

enum AbnormalType {
  HIGH
  LOW
  CRITICAL_HIGH
  CRITICAL_LOW
}

// ─── Core Tenant Model ─────────────────────────────────────────────────────

model Organization {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  type                  OrganizationType @default(HOSPITAL)
  email                 String
  phone                 String
  address               String?
  city                  String?
  state                 String?
  country               String           @default("IN")
  pincode               String?
  logo                  String?
  website               String?
  licenseNumber         String?
  taxId                 String?
  settings              Json             @default("{}")
  subscriptionTier      SubscriptionTier @default(FREE)
  subscriptionExpiresAt DateTime?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  users           User[]
  roles           Role[]
  hospitals       Hospital[]
  departments     Department[]
  doctors         Doctor[]
  patients        Patient[]
  appointments    Appointment[]
  encounters      Encounter[]
  labTests        LabTest[]
  radiologyOrders RadiologyOrder[]
  invoices        Invoice[]
  staff           Staff[]
  beds            Bed[]
  wards           Ward[]
  medications     Medication[]
  inventoryItems  InventoryItem[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  prescriptions   Prescription[]
  admissions      Admission[]
  insuranceClaims InsuranceClaim[]
  doctorSchedules DoctorSchedule[]
  doctorLeaves    DoctorLeave[]

  @@index([slug])
  @@map("organizations")
}

// ─── Identity & Access ─────────────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatar              String?
  status              UserStatus @default(PENDING_VERIFICATION)
  isEmailVerified     Boolean    @default(false)
  timezone            String     @default("Asia/Kolkata")
  mfaEnabled          Boolean    @default(false)
  mfaSecret           String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  organizationId      String
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  userRoles     UserRole[]
  doctorProfile Doctor?
  staffProfile  Staff?
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id             String      @id @default(cuid())
  name           String
  description    String?
  systemRole     SystemRole?
  organizationId String
  createdAt      DateTime    @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  scope       String  @default("all")
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  hospitalId String?
  assignedAt DateTime @default(now())
  assignedBy String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([hospitalId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Organization Structure ────────────────────────────────────────────────

model Hospital {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String   @default("IN")
  pincode        String?
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  departments  Department[]
  userRoles    UserRole[]
  doctors      Doctor[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("hospitals")
}

model Department {
  id             String   @id @default(cuid())
  name           String
  code           String
  description    String?
  headDoctorId   String?
  hospitalId     String
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  doctors      Doctor[]
  staff        Staff[]
  wards        Ward[]
  appointments Appointment[]

  @@unique([code, hospitalId])
  @@index([organizationId])
  @@index([hospitalId])
  @@map("departments")
}

model Doctor {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  registrationNumber String
  specialization     String
  subSpecialization  String?
  qualification      String
  experienceYears    Int                      @default(0)
  languagesSpoken    String[]                 @default([])
  departmentId       String?
  hospitalId         String
  organizationId     String
  consultationFee    Decimal                  @db.Decimal(10, 2)
  availabilityStatus DoctorAvailabilityStatus @default(AVAILABLE)
  joiningDate        DateTime
  bio                String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  hospital        Hospital         @relation(fields: [hospitalId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  radiologyOrders RadiologyOrder[]
  schedules       DoctorSchedule[]
  leaves          DoctorLeave[]
  documents       DoctorDocument[]

  @@unique([registrationNumber, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([hospitalId])
  @@map("doctors")
}

// ─── Provider Scheduling ───────────────────────────────────────────────────
//
// Modeled per-provider-type (Doctor) rather than through a polymorphic
// "Provider" table — see ADR-0006. The *algorithm* in AvailabilityService
// (weekly schedule + leave overlay + shift/break slot slicing) is written
// generically enough that a future provider type (Nurse, Physiotherapist,
// etc.) can stand up its own {Type}Schedule/{Type}ScheduleDay/{Type}Leave
// trio and near-identical service without redesigning the approach.

model DoctorSchedule {
  id             String   @id @default(cuid())
  doctorId       String
  organizationId String
  // The date this version takes effect from. Selecting "the schedule that
  // applies on date X" = the isActive row with the greatest effectiveFrom
  // that is <= X — this lets a new version be created ahead of time
  // (effectiveFrom in the future) without disturbing what's currently in
  // effect, and keeps every prior version in place for history/audit
  // instead of overwriting it in place.
  effectiveFrom  DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id])
  days         DoctorScheduleDay[]

  @@unique([doctorId, effectiveFrom])
  @@index([doctorId])
  @@index([organizationId])
  @@index([doctorId, isActive, effectiveFrom])
  @@map("doctor_schedules")
}

model DoctorScheduleDay {
  id           String   @id @default(cuid())
  scheduleId   String
  dayOfWeek    Weekday
  isWorkingDay Boolean  @default(true)
  // ScheduleShift[] — see packages/types/src/doctor-schedule.ts. Kept as JSON
  // (like Doctor.languagesSpoken/Organization.settings elsewhere in this
  // schema) since a day's shifts+breaks are always read/written together as
  // one unit from the schedule editor, never queried independently.
  shifts       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedule DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
  @@map("doctor_schedule_days")
}

model DoctorLeave {
  id              String      @id @default(cuid())
  doctorId        String
  organizationId  String
  leaveType       LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  reason          String?
  status          LeaveStatus @default(PENDING)
  appliedByUserId String
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([doctorId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([doctorId, startDate, endDate])
  @@map("doctor_leaves")
}

enum DoctorDocumentType {
  MEDICAL_DEGREE
  MEDICAL_LICENSE
  EXPERIENCE_CERTIFICATE
  ID_PROOF
  OTHER
}

model DoctorDocument {
  id             String             @id @default(cuid())
  doctorId       String
  organizationId String
  documentType   DoctorDocumentType
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime           @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_documents")
}

model Staff {
  id             String    @id @default(cuid())
  userId         String    @unique
  employeeId     String
  designation    String
  departmentId   String?
  organizationId String
  shiftType      ShiftType @default(MORNING)
  joiningDate    DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([employeeId, organizationId])
  @@index([organizationId])
  @@map("staff")
}

// ─── Patient ───────────────────────────────────────────────────────────────

model Patient {
  id                    String      @id @default(cuid())
  uhid                  String
  firstName             String
  lastName              String
  email                 String?
  phone                 String
  dateOfBirth           DateTime
  gender                Gender
  bloodGroup            BloodGroup?
  address               String?
  city                  String?
  state                 String?
  country               String      @default("IN")
  pincode               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  organizationId        String
  metadata              Json        @default("{}")
  isActive              Boolean     @default(true)
  deletedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  documents       PatientDocument[]
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  radiologyOrders RadiologyOrder[]
  invoices        Invoice[]
  admissions      Admission[]
  insuranceClaims InsuranceClaim[]
  notifications   Notification[]

  @@unique([uhid, organizationId])
  @@unique([phone, organizationId])
  @@index([organizationId])
  @@index([uhid])
  @@index([phone])
  @@map("patients")
}

model PatientDocument {
  id             String       @id @default(cuid())
  patientId      String
  organizationId String
  documentType   DocumentType
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime     @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_documents")
}

// ─── Appointments ──────────────────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String
  patientId         String
  doctorId          String
  departmentId      String?
  organizationId    String
  scheduledAt       DateTime
  durationMinutes   Int               @default(15)
  type              AppointmentType   @default(OPD)
  status            AppointmentStatus @default(SCHEDULED)
  chiefComplaint    String?
  notes             String?
  roomNumber        String?
  referredBy        String?
  // `isWalkIn`/`recurrenceGroupId` — see ADR-0007. A walk-in still has a
  // real `scheduledAt` (the receptionist assigns the next available slot
  // automatically); the flag only distinguishes how it was booked, for
  // reporting/queue-display purposes. `recurrenceGroupId` links every
  // occurrence created from one recurring-booking request — null for a
  // one-off appointment.
  isWalkIn          Boolean           @default(false)
  recurrenceGroupId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  organization  Organization   @relation(fields: [organizationId], references: [id])
  encounter     Encounter?
  labTests      LabTest[]
  invoice       Invoice?

  @@unique([appointmentNumber, organizationId])
  @@index([organizationId])
  @@index([doctorId, scheduledAt])
  @@index([patientId, organizationId])
  @@index([status, organizationId, scheduledAt])
  @@index([recurrenceGroupId])
  @@map("appointments")
}

// ─── Clinical — EMR (see ADR-0008) ─────────────────────────────────────────
//
// `Encounter` is the longitudinal EMR's central entity — one per
// consultation, created from a completed `Appointment`. Everything a
// clinician records during that consultation hangs off it as its own
// child table (`ClinicalNote`, `Vital`, `Diagnosis`, `Procedure`,
// `EncounterAttachment`) rather than being flat columns on `Encounter`
// itself, so each facet can evolve/be queried independently — most
// importantly `ClinicalNote`, which is append-only (see its own comment).

enum EncounterType {
  OPD
  TELECONSULTATION
  FOLLOW_UP
  EMERGENCY
  WALK_IN
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  AMENDED
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

model Encounter {
  id             String          @id @default(cuid())
  patientId      String
  doctorId       String
  appointmentId  String?         @unique
  organizationId String
  type           EncounterType   @default(OPD)
  status         EncounterStatus @default(IN_PROGRESS)
  notes          String?
  encounterDate  DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient       Patient               @relation(fields: [patientId], references: [id])
  doctor        Doctor                @relation(fields: [doctorId], references: [id])
  appointment   Appointment?          @relation(fields: [appointmentId], references: [id])
  organization  Organization          @relation(fields: [organizationId], references: [id])
  clinicalNotes ClinicalNote[]
  vitals        Vital[]
  diagnoses     Diagnosis[]
  procedures    Procedure[]
  attachments   EncounterAttachment[]
  prescriptions Prescription[]

  @@index([patientId, organizationId])
  @@index([doctorId, organizationId])
  @@index([organizationId])
  @@map("encounters")
}

/// Append-only: an edit inserts a new row with `version = previous + 1`
/// rather than updating in place — "never overwrite historical notes" is
/// enforced by never exposing an `update` at the service layer, not just
/// by convention. The current note is the highest `version` per encounter.
model ClinicalNote {
  id                      String   @id @default(cuid())
  encounterId             String
  version                 Int
  chiefComplaint          String?
  historyOfPresentIllness String?
  pastMedicalHistory      String?
  familyHistory           String?
  surgicalHistory         String?
  socialHistory           String?
  allergies               String?
  currentMedications      String?
  createdByUserId         String
  createdAt               DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@unique([encounterId, version])
  @@index([encounterId])
  @@map("clinical_notes")
}

model Vital {
  id                     String   @id @default(cuid())
  encounterId            String
  heightCm               Float?
  weightKg               Float?
  /// Computed server-side from height/weight at write time — denormalized
  /// so trend/chart queries don't recompute float math per row.
  bmi                     Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulse                  Int?
  temperatureCelsius     Float?
  respiratoryRate        Int?
  spo2                   Int?
  recordedByUserId       String
  recordedAt             DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("vitals")
}

model Diagnosis {
  id          String        @id @default(cuid())
  encounterId String
  type        DiagnosisType @default(PRIMARY)
  description String
  /// Placeholder, not a validated lookup against a real ICD-10 terminology
  /// service — see ADR-0008/TECH_DEBT.
  icdCode     String?
  createdAt   DateTime      @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("diagnoses")
}

model Procedure {
  id          String   @id @default(cuid())
  encounterId String
  name        String
  notes       String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("procedures")
}

enum EncounterAttachmentType {
  CLINICAL_DOCUMENT
  IMAGE
  EXTERNAL_REPORT
  OTHER
}

model EncounterAttachment {
  id             String                  @id @default(cuid())
  encounterId    String
  organizationId String
  documentType   EncounterAttachmentType @default(OTHER)
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime                @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("encounter_attachments")
}

model Prescription {
  id                 String   @id @default(cuid())
  prescriptionNumber String
  patientId          String
  doctorId           String
  encounterId        String?
  organizationId     String
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  prescribedAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient      Patient            @relation(fields: [patientId], references: [id])
  doctor       Doctor             @relation(fields: [doctorId], references: [id])
  encounter    Encounter?         @relation(fields: [encounterId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  items        PrescriptionItem[]

  @@unique([prescriptionNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  medicationName String
  genericName    String?
  strength       String?
  form           String?
  dosage         String
  frequency      String
  duration       String
  route          String   @default("ORAL")
  instructions   String?
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ─── Laboratory ────────────────────────────────────────────────────────────

model LabTest {
  id                String        @id @default(cuid())
  labOrderNumber    String
  patientId         String
  doctorId          String
  appointmentId     String?
  organizationId    String
  status            LabTestStatus @default(ORDERED)
  priority          Priority      @default(ROUTINE)
  sampleCollectedBy String?
  sampleCollectedAt DateTime?
  reportedAt        DateTime?
  reportFileUrl     String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  items        LabTestItem[]

  @@unique([labOrderNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@map("lab_tests")
}

model LabTestItem {
  id             String        @id @default(cuid())
  labTestId      String
  testName       String
  testCode       String
  category       String
  result         String?
  unit           String?
  referenceRange String?
  isAbnormal     Boolean       @default(false)
  abnormalType   AbnormalType?
  interpretation String?
  createdAt      DateTime      @default(now())

  labTest LabTest @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  @@index([labTestId])
  @@map("lab_test_items")
}

// ─── Radiology ─────────────────────────────────────────────────────────────

model RadiologyOrder {
  id                 String          @id @default(cuid())
  orderNumber        String
  patientId          String
  doctorId           String
  organizationId     String
  modality           String
  bodyPart           String
  clinicalIndication String?
  status             RadiologyStatus @default(ORDERED)
  priority           Priority        @default(ROUTINE)
  reportFileUrl      String?
  findings           String?
  impression         String?
  reportedBy         String?
  reportedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([orderNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@map("radiology_orders")
}

// ─── Inpatient ─────────────────────────────────────────────────────────────

model Ward {
  id             String   @id @default(cuid())
  name           String
  code           String
  departmentId   String?
  organizationId String
  totalBeds      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  beds         Bed[]
  admissions   Admission[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@map("wards")
}

model Bed {
  id             String    @id @default(cuid())
  bedNumber      String
  wardId         String
  organizationId String
  type           BedType   @default(GENERAL)
  status         BedStatus @default(AVAILABLE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ward         Ward         @relation(fields: [wardId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  admissions   Admission[]

  @@unique([bedNumber, wardId])
  @@index([organizationId])
  @@index([wardId, status])
  @@map("beds")
}

model Admission {
  id                 String          @id @default(cuid())
  admissionNumber    String
  patientId          String
  doctorId           String?
  bedId              String?
  wardId             String?
  organizationId     String
  status             AdmissionStatus @default(ADMITTED)
  admissionReason    String
  diagnosis          String?
  admittedAt         DateTime        @default(now())
  dischargedAt       DateTime?
  dischargeNotes     String?
  dischargeCondition String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  bed          Bed?         @relation(fields: [bedId], references: [id])
  ward         Ward?        @relation(fields: [wardId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([admissionNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@map("admissions")
}

// ─── Billing ───────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  patientId      String
  appointmentId  String?       @unique
  organizationId String
  status         InvoiceStatus @default(DRAFT)
  type           InvoiceType   @default(OPD)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  notes          String?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  insuranceClaim InsuranceClaim?

  @@unique([invoiceNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([status, organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  itemName        String
  itemCode        String?
  category        String
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String
  invoiceId       String
  patientId       String
  organizationId  String
  amount          Decimal       @db.Decimal(12, 2)
  paymentMode     PaymentMode
  transactionId   String?
  referenceNumber String?
  status          PaymentStatus @default(COMPLETED)
  collectedBy     String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentNumber, organizationId])
  @@index([invoiceId])
  @@index([patientId, organizationId])
  @@map("payments")
}

model InsuranceClaim {
  id                String               @id @default(cuid())
  claimNumber       String
  patientId         String
  invoiceId         String               @unique
  organizationId    String
  insuranceProvider String
  policyNumber      String
  membershipId      String?
  claimedAmount     Decimal              @db.Decimal(12, 2)
  approvedAmount    Decimal?             @db.Decimal(12, 2)
  rejectedAmount    Decimal?             @db.Decimal(12, 2)
  status            InsuranceClaimStatus @default(DRAFT)
  rejectionReason   String?
  submittedAt       DateTime?
  settledAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([claimNumber, organizationId])
  @@index([patientId, organizationId])
  @@map("insurance_claims")
}

// ─── Pharmacy & Inventory ──────────────────────────────────────────────────

model Medication {
  id             String   @id @default(cuid())
  name           String
  genericName    String?
  manufacturer   String?
  strength       String?
  form           String?
  category       String
  organizationId String
  isActive       Boolean  @default(true)
  unitPrice      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("medications")
}

model InventoryItem {
  id              String   @id @default(cuid())
  name            String
  sku             String
  category        String
  organizationId  String
  quantityInStock Int      @default(0)
  reorderLevel    Int      @default(10)
  reorderQuantity Int      @default(50)
  unitCost        Decimal  @default(0) @db.Decimal(10, 2)
  storageLocation String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([sku, organizationId])
  @@index([organizationId])
  @@map("inventory_items")
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String?
  patientId      String?
  type           NotificationType
  title          String
  body           String
  data           Json                @default("{}")
  isRead         Boolean             @default(false)
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(PENDING)
  failureReason  String?
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])

  @@index([organizationId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Audit ─────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([resource, resourceId, organizationId])
  @@index([userId, organizationId])
  @@map("audit_logs")
}
