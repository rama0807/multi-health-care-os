  NIGHT
  ROTATING
}

enum DoctorAvailabilityStatus {
  AVAILABLE
  ON_LEAVE
  UNAVAILABLE
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  CONFERENCE
  TRAINING
  EMERGENCY
  HOLIDAY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SystemRole {
  SUPER_ADMIN
  ORG_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  RADIOLOGY_TECHNICIAN
  PHARMACIST
  CASHIER
  HR
  INVENTORY_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  INSURANCE_CARD
  MEDICAL_REPORT
  PRESCRIPTION
  OTHER
}

enum NotificationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  LAB_RESULT_READY
  INVOICE_GENERATED
  PAYMENT_RECEIVED
  PRESCRIPTION_READY
  DISCHARGE_SUMMARY
  CUSTOM
}

