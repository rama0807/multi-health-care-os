/// The *event* a notification reports. One value per real trigger wired in
/// `notification-events.listener.ts` (Milestone 18 Checkpoint 18.4) - a value
/// is only added here once something actually emits it, so this enum doubles
/// as the list of events the platform genuinely reacts to.
enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  ENCOUNTER_CREATED
  ENCOUNTER_UPDATED
  LAB_SAMPLE_COLLECTED
  LAB_RESULT_READY
  RADIOLOGY_REPORT_RELEASED
  INVOICE_GENERATED
  PAYMENT_RECEIVED
  PREAUTH_APPROVED
  CLAIM_APPROVED
  CLAIM_REJECTED
  PRESCRIPTION_READY
  MEDICINE_DISPENSED
  INVENTORY_LOW_STOCK
  INVENTORY_REORDER_LEVEL
  IPD_ADMITTED
  IPD_TRANSFERRED
  IPD_DISCHARGED
  DISCHARGE_SUMMARY
  STAFF_LEAVE_APPROVED
  STAFF_SHIFT_ASSIGNED
  SCHEDULED_REPORT_READY
  ORGANIZATION_ONBOARDED
  HOSPITAL_CREATED
  CUSTOM
}

/// The grouping a *user* reasons about when configuring preferences. Types
/// are per-event and would make an unusable preferences screen; categories
/// are the switches `NotificationPreference.categoryPreferences` holds.
enum NotificationCategory {
  APPOINTMENT
  CLINICAL
  LABORATORY
  RADIOLOGY
  BILLING
  INSURANCE
  PHARMACY
  INVENTORY
  IPD
  STAFF
  REPORTS
  PLATFORM
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
  WHATSAPP
}

/// `CRITICAL` deliberately bypasses quiet hours and per-category mutes (a
/// critical result must reach the clinician); `SILENT` is written to the
/// in-app centre only and never raises push, email, SMS or WhatsApp.
enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  SILENT
}

/// The *notification's* overall state, derived from its per-channel
/// `NotificationDelivery` rows by `NotificationDispatcherService`. `SENT`
/// means every attempted channel succeeded; `PARTIALLY_SENT` means at least
/// one did and at least one exhausted its retries.
enum NotificationStatus {
  PENDING
  SCHEDULED
  QUEUED
  SENT
  PARTIALLY_SENT
  DELIVERED
  FAILED
  CANCELLED
  READ
}

/// One channel attempt's state. Separate from `NotificationStatus` because a
/// single notification fans out to several channels that succeed and fail
/// independently - collapsing them onto the notification row would make
/// "which channel actually failed?" unanswerable.
enum NotificationDeliveryStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  /// The channel was suppressed before dispatch - muted category, quiet
  /// hours, disabled channel, or no destination address on file. Not a
  /// failure: nothing was attempted, and it is never retried.
  SKIPPED
  CANCELLED
}

/// How often a user wants non-critical email.
enum EmailDigestFrequency {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY
  NEVER
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

/// See ADR-0016. `UNDER_REVIEW` already covers what a payer calls a claim
