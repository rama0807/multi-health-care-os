  notes             String?
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  issuedByUserId    String?
  issuedAt          DateTime?
  receivedByUserId  String?
  receivedAt        DateTime?
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  fromStore    InventoryStore         @relation("RequisitionFromStore", fields: [fromStoreId], references: [id])
  toStore      InventoryStore         @relation("RequisitionToStore", fields: [toStoreId], references: [id])
