generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  NURSING_HOME
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum AppointmentType {
  OPD
  IPD
  EMERGENCY
  PROCEDURE
  FOLLOW_UP
  TELECONSULTATION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  OPD
  IPD
  LABORATORY
  RADIOLOGY
  PHARMACY
  PROCEDURE
  MISCELLANEOUS
}

enum PaymentMode {
  CASH
  CARD
  UPI
  NEFT
  RTGS
  CHEQUE
  INSURANCE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── Charge Engine — see ADR-0015. `Charge` is the reusable line-item entity
// every clinical module (or a manual cashier action) creates one row of;
// `sourceModule`/`sourceId` record where it came from without a hard FK into
// each clinical module's own tables (mirrors the `sampleCollectedBy`-style
// "actor" convention already used for cross-module references).
enum ChargeSourceModule {
  APPOINTMENT
  CONSULTATION
  LABORATORY
  RADIOLOGY
  PHARMACY
  PROCEDURE
  MISCELLANEOUS
}

enum ChargeStatus {
  PENDING
  INVOICED
  VOIDED
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum DiscountApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum LabTestStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  REPORTED
  CANCELLED
}

enum RadiologyStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REPORTED
  CANCELLED
  REJECTED
}

enum RadiologyAttachmentType {
  IMAGE
  EXTERNAL_IMAGING
  DICOM_PLACEHOLDER
  PDF
  OTHER
}

enum Priority {
  ROUTINE
  URGENT
  STAT
}

enum BedType {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
  NICU
  HDU
  ISOLATION
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  UNDER_MAINTENANCE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
  ABSCONDED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  ROTATING
}

enum DoctorAvailabilityStatus {
