enum AssetStatus {
  IN_USE
  IN_STORE
  UNDER_MAINTENANCE
  BREAKDOWN
  DECOMMISSIONED
}

/// One row per physical unit of an `InventoryItem` with `itemType: ASSET`
/// (a biomedical device, a bed's monitor, etc.) - mirrors `Drug`'s
/// "one row is one real-world unit" idiom, adapted for serialized
/// equipment instead of a drug batch. Current assignment is denormalized
/// here (`assignedToUserId`/`assignedToDepartmentId`) for quick lookup,
/// same "quick lookup + history child table" idiom as `Bed.status` +
/// `BedAllocation`.
model Asset {
  id                     String      @id @default(cuid())
  organizationId         String
  itemId                 String
  storeId                String
  assetTag               String
  serialNumber           String?
  status                 AssetStatus @default(IN_STORE)
  purchaseDate           DateTime?
  purchasePrice          Decimal?    @db.Decimal(12, 2)
  warrantyExpiryDate     DateTime?
  amcVendorId            String?
  amcStartDate           DateTime?
  amcEndDate             DateTime?
  lastCalibrationDate    DateTime?
  nextCalibrationDate    DateTime?
  assignedToUserId       String?
  assignedToDepartmentId String?
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  organization         Organization             @relation(fields: [organizationId], references: [id])
  item                 InventoryItem            @relation(fields: [itemId], references: [id])
  store                InventoryStore           @relation(fields: [storeId], references: [id])
  amcVendor            Vendor?                  @relation(fields: [amcVendorId], references: [id])
  assignedToDepartment Department?              @relation(fields: [assignedToDepartmentId], references: [id])
  maintenanceRecords   AssetMaintenanceRecord[]
  assignments          AssetAssignment[]

  @@unique([assetTag, organizationId])
  @@index([organizationId, status])
  @@index([storeId])
  @@map("assets")
}

enum AssetMaintenanceType {
  PREVENTIVE
  CALIBRATION
  AMC
  BREAKDOWN
  REPAIR
}

enum AssetMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Covers both "Maintenance Schedule" (a row with `status: SCHEDULED` and
/// a future `scheduledDate`) and "Breakdown History" (a row with
/// `type: BREAKDOWN`, completed) in one model - the roadmap lists them as
/// related facets of the same underlying concept (asset service events),
/// not two independently-shaped entities.
model AssetMaintenanceRecord {
  id             String                 @id @default(cuid())
  organizationId String
  assetId        String
  type           AssetMaintenanceType
  status         AssetMaintenanceStatus @default(SCHEDULED)
  scheduledDate  DateTime?
  completedDate  DateTime?
  description    String
  cost           Decimal?               @db.Decimal(12, 2)
  performedBy    String?
  vendorId       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  @@index([organizationId])
  @@index([assetId])
  @@map("asset_maintenance_records")
}

/// History of who/where an asset has been assigned - `Asset.assignedTo*`
/// always reflects the latest (or null once returned) row here.
model AssetAssignment {
  id                     String    @id @default(cuid())
  organizationId         String
  assetId                String
  assignedToUserId       String?
  assignedToDepartmentId String?
  storeId                String?
  assignedByUserId       String
  assignedAt             DateTime  @default(now())
  returnedAt             DateTime?
  notes                  String?

  organization Organization    @relation(fields: [organizationId], references: [id])
  asset        Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  store        InventoryStore? @relation(fields: [storeId], references: [id])

  @@index([organizationId])
  @@index([assetId])
  @@map("asset_assignments")
}

enum StockAuditStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StockAudit {
  id                String           @id @default(cuid())
  organizationId    String
  auditNumber       String
  storeId           String
  status            StockAuditStatus @default(DRAFT)
  scheduledDate     DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  conductedByUserId String
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  store        InventoryStore   @relation(fields: [storeId], references: [id])
  items        StockAuditItem[]

  @@unique([auditNumber, organizationId])
  @@index([organizationId, status])
  @@map("stock_audits")
}

/// `varianceQuantity` is computed and stored at count-entry time (not
/// derived at read time) because it's a snapshot of a discrepancy found at
/// a specific moment - the underlying `InventoryStock.currentStock` may
/// have already moved on by the time the audit is reviewed later.
model StockAuditItem {
  id               String  @id @default(cuid())
  stockAuditId     String
  itemId           String
  batchId          String?
  systemQuantity   Int
  countedQuantity  Int?
  varianceQuantity Int?
  remarks          String?

  stockAudit StockAudit      @relation(fields: [stockAuditId], references: [id], onDelete: Cascade)
  item       InventoryItem   @relation(fields: [itemId], references: [id])
  batch      InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([stockAuditId])
  @@map("stock_audit_items")
}

// ─── Notifications ─────────────────────────────────────────────────────────

// ─── Communication & Notifications (Milestone 18 / ADR-0027) ───────────────

/// One message to one recipient. Channel fan-out lives in
/// `NotificationDelivery`, one row per channel, so this table stays the
/// single record of "what was said to whom" regardless of how many
/// transports carried it.
///
/// `eventKey` is the idempotency handle: an event listener that fires twice
/// for the same source row (a retried transaction, a duplicated emit)
/// produces one notification, not two. It is scoped per recipient because
/// the same event legitimately notifies several people.
model Notification {
  id             String               @id @default(cuid())
  organizationId String
  /// Nullable because platform-level and org-wide notifications belong to no
  /// single hospital, and every tenant here may run more than one.
  hospitalId     String?
  /// The user this notification is addressed to. Nullable only for
  /// patient-addressed messages, which reach a patient by email/SMS/WhatsApp
  /// and never appear in a staff member's in-app centre.
  recipientId    String?
  patientId      String?
  type           NotificationType
  category       NotificationCategory
  priority       NotificationPriority @default(NORMAL)
  title          String
  body           String
  /// Lucide icon name rendered by the notification centre. Free text rather
  /// than an enum: the icon set is a frontend concern and changes without a
  /// migration.
  icon           String?
  imageUrl       String?
  /// In-app route the notification opens - `/dashboard/appointments/{id}`
  /// and friends. Also carried into the push payload so a background
  /// notification click lands on the same page.
  deepLink       String?
  /// Template variables plus any source identifiers. Never holds clinical
  /// free text beyond what `title`/`body` already say.
  payload        Json                 @default("{}")
  /// Set for a future-dated notification; null means dispatch immediately.
  scheduleAt     DateTime?
  /// Dispatch attempts made across all channels - the per-channel counter
  /// that actually drives backoff lives on `NotificationDelivery.attempts`.
  retryCount     Int                  @default(0)
  deliveryStatus NotificationStatus   @default(PENDING)
  failureReason  String?
  isRead         Boolean              @default(false)
  readAt         DateTime?
  isArchived     Boolean              @default(false)
  archivedAt     DateTime?
  isPinned       Boolean              @default(false)
  pinnedAt       DateTime?
  sentAt         DateTime?
  /// Idempotency key, unique per recipient. See the model comment.
  eventKey       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  hospital     Hospital?              @relation(fields: [hospitalId], references: [id])
  recipient    User?                  @relation(fields: [recipientId], references: [id])
  patient      Patient?               @relation(fields: [patientId], references: [id])
  deliveries   NotificationDelivery[]

  @@unique([recipientId, eventKey])
  @@index([organizationId, createdAt])
  @@index([recipientId, isRead, isArchived])
  @@index([organizationId, deliveryStatus])
  @@index([deliveryStatus, scheduleAt])
  @@map("notifications")
}

/// One channel attempt against one notification. This is also the retry
/// queue: `NotificationQueueService` claims rows whose `nextAttemptAt` has
/// elapsed, so queue state and delivery history are the same durable record
/// rather than two that can disagree (ADR-0027).
model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  organizationId    String
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  /// Where it was actually sent - email address, phone number, or the
  /// `UserDevice` id for push. Recorded so a delivery can be explained after
  /// the user's contact details change.
  destination       String?
  attempts          Int                        @default(0)
  /// Null once the row reaches a terminal state; otherwise the earliest time
  /// the worker may try again (exponential backoff).
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  /// Which adapter handled it (`resend`, `fcm`, `log-sms`, …) and the id it
  /// returned, so a delivery can be traced in the provider's own console.
  providerName      String?
  providerMessageId String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([notificationId, channel])
  @@index([organizationId, status])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// An organization's override of a bundled default template, versioned
/// append-only exactly like `AiPromptTemplate` - editing a template changes
/// what every future recipient reads, so the previous wording stays
/// recoverable. A `(key, channel)` pair with no row here falls back to the
/// bundled default in `default-templates.ts`.
model NotificationTemplate {
  id               String               @id @default(cuid())
  organizationId   String
  /// Matches `NotificationType` for event-driven templates; free text so an
  /// organization can also add templates for its own broadcast messages.
  key              String
  channel          NotificationChannel
  version          Int
  name             String
  description      String?
  category         NotificationCategory
  priority         NotificationPriority @default(NORMAL)
  /// Email subject / push title. Null for channels that carry a body only.
  subjectTemplate  String?
  bodyTemplate     String
  deepLinkTemplate String?
  /// Variable names the template declares, for the admin editor's help text.
  /// Rendering does not depend on it - an undeclared variable still renders.
  variables        Json                 @default("[]")
  isActive         Boolean              @default(true)
  createdByUserId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key, channel, version])
  @@index([organizationId, key, channel])
  @@map("notification_templates")
}

/// One row per user. Absent means "every default applies" - the services
/// never require a row to exist, so a user who has never opened the
/// preferences page still receives notifications.
model NotificationPreference {
  id                  String               @id @default(cuid())
  organizationId      String
  userId              String               @unique
  inAppEnabled        Boolean              @default(true)
  emailEnabled        Boolean              @default(true)
  pushEnabled         Boolean              @default(true)
  smsEnabled          Boolean              @default(false)
  whatsappEnabled     Boolean              @default(false)
  emailFrequency      EmailDigestFrequency @default(IMMEDIATE)
  /// `HH:mm` local wall-clock, evaluated in `timezone`. Both null means no
  /// quiet hours. A window may wrap midnight (22:00 → 07:00).
  quietHoursStart     String?
  quietHoursEnd       String?
  /// IANA zone the quiet-hours window is read in; defaults to the user's own
  /// `User.timezone` when a row is first created.
  timezone            String               @default("Asia/Kolkata")
  /// `{ "<NotificationCategory>": { "enabled": bool, "channels": [...] } }`.
  /// A category absent from the map is enabled with the channel defaults
  /// above - new categories therefore never arrive silently muted.
  categoryPreferences Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_preferences")
}

/// A push destination. One user has many - a browser is one device, and the
/// same person legitimately runs several. Deliberately not web-only:
/// `platform` and an opaque `token` are all the FCM adapter needs, so a
/// future mobile app registers here unchanged (Checkpoint 18.2).
model UserDevice {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  /// FCM registration token. Unique because FCM reissues a token to at most
  /// one installation - a token appearing again means the device moved, and
  /// registration re-points the existing row rather than duplicating it.
  token          String         @unique
  platform       DevicePlatform @default(WEB)
  /// User-facing label ("Chrome on MacBook Pro"), best-effort from the UA.
  deviceName     String?
  browser        String?
  osName         String?
  userAgent      String?
  isActive       Boolean        @default(true)
  /// Cleared on a successful send, set when FCM reports the token
  /// unregistered - the row is deactivated rather than deleted so delivery
  /// history keeps pointing at something real.
  deactivatedAt  DateTime?
  lastSeenAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([organizationId])
  @@map("user_devices")
}

// ─── Audit ─────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([resource, resourceId, organizationId])
  @@index([userId, organizationId])
  @@map("audit_logs")
}

// ─── AI (Milestone 15, Checkpoint 15.1 - ADR-0023) ─────────────────────────

/// Which vendor adapter served a request. Stored per `AiUsageLog` row (not
/// read back from config at report time) so historical usage stays accurate
/// after an org switches providers.
enum AiProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  OLLAMA
}

/// One value per clinical generator. Also the feature-flag key
/// (`AI_DISABLED_FEATURES`) and the prompt-template lookup key.
enum AiFeature {
  SOAP_NOTE
  CLINICAL_NOTE_SUMMARY
  LAB_RESULT_SUMMARY
  RADIOLOGY_REPORT_SUMMARY
  PRESCRIPTION_EXPLANATION
  DISCHARGE_SUMMARY
  REFERRAL_LETTER
}

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AiRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A single AI interaction thread. Checkpoint 15.1 writes exactly one
/// assistant turn per conversation (the generators are one-shot); the model
/// is multi-turn-shaped on purpose so Checkpoint 15.4's chat assistant
/// continues an existing thread rather than needing a second table.
model AiConversation {
  id               String    @id @default(cuid())
  organizationId   String
  feature          AiFeature
  title            String
  /// Context the generation was run against - all optional because which one
  /// applies depends on `feature` (an encounter for SOAP notes, an admission
  /// for a discharge summary, and so on).
  patientId        String?
  encounterId      String?
  labTestId        String?
  radiologyOrderId String?
  prescriptionId   String?
  admissionId      String?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  messages     AiMessage[]
  usageLogs    AiUsageLog[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([patientId])
  @@index([encounterId])
  @@index([createdByUserId])
  @@map("ai_conversations")
}

/// Append-only transcript of a conversation. `sequence` is 0-based and unique
/// per conversation, so replaying a thread never depends on `createdAt`
/// tie-breaking (system + user messages are written in the same millisecond).
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  sequence       Int
  role           AiMessageRole
  content        String
  tokenCount     Int?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId])
  @@map("ai_messages")
}

/// One row per provider dispatch (including failed ones), for per-org usage
/// tracking and token accounting. `tokensEstimated` is the honesty flag: a
/// provider that returns real usage sets it `false`; a stream that omits
/// usage falls back to a documented heuristic and sets it `true`, so no
/// consumer can mistake an estimate for a metered count (ADR-0023).
model AiUsageLog {
  id               String          @id @default(cuid())
  organizationId   String
  conversationId   String?
  userId           String?
  feature          AiFeature
  provider         AiProviderType
  model            String
  status           AiRequestStatus @default(PENDING)
  streamed         Boolean         @default(false)
  promptTokens     Int             @default(0)
  completionTokens Int             @default(0)
  totalTokens      Int             @default(0)
  tokensEstimated  Boolean         @default(false)
  /// Derived from `AI_INPUT_COST_PER_1K`/`AI_OUTPUT_COST_PER_1K`, which
  /// default to 0 - a 0 here means "no price configured," not "free."
  estimatedCostUsd Decimal         @default(0) @db.Decimal(12, 6)
  latencyMs        Int             @default(0)
  /// How many provider calls this dispatch took, including retries.
  attempts         Int             @default(1)
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime        @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user         User?           @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, feature])
  @@index([conversationId])
  @@map("ai_usage_logs")
}

/// Org-scoped, versioned override of a bundled default prompt. The defaults
/// in `modules/ai/prompts/` are the source of truth and always work against
/// an empty table; a row here only wins when it is the highest `version` for
/// its (organization, feature) pair *and* `isActive` (ADR-0023).
model AiPromptTemplate {
  id                 String    @id @default(cuid())
  organizationId     String
  feature            AiFeature
  version            Int
  systemPrompt       String
  userPromptTemplate String
  description        String?
  isActive           Boolean   @default(true)
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, feature, version])
  @@index([organizationId, feature])
  @@map("ai_prompt_templates")
}

// ─── Reports & Analytics (Milestone 17 / ADR-0026) ─────────────────────────

/// A named, re-runnable set of filters against one report in the registry -
/// the only table Milestone 17 adds. Reports themselves are pure read-only
/// aggregations over tables other modules already own, so nothing here
/// caches or duplicates a result: `reportKey` names a `ReportDefinition` in
/// `modules/reports/report-registry.ts` and `filters` holds that run's
/// parameters, nothing more.
///
/// `scheduleCron`/`scheduleRecipients`/`scheduleEnabled` are a **disclosed
/// placeholder** (see TECH_DEBT TD-0053): the fields persist a schedule so
/// Milestone 18 (Notifications & Communication) has somewhere to read from,
/// but no job in this repo dispatches them - the same "disclosed
/// placeholder, not a fake feature" practice as the DICOM/ICD-10/payment-QR
/// placeholders in earlier milestones.
model SavedReport {
  id                 String    @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  reportKey          String
  filters            Json      @default("{}")
  isShared           Boolean   @default(false)
  createdByUserId    String
  scheduleEnabled    Boolean   @default(false)
  scheduleCron       String?
  scheduleRecipients String[]  @default([])
  lastRunAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, reportKey])
  @@map("saved_reports")
}
