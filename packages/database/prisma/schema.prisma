model Doctor {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  registrationNumber String
  specialization     String
  subSpecialization  String?
  qualification      String
  experienceYears    Int                      @default(0)
  languagesSpoken    String[]                 @default([])
  departmentId       String?
  hospitalId         String
  organizationId     String
  consultationFee    Decimal                  @db.Decimal(10, 2)
  availabilityStatus DoctorAvailabilityStatus @default(AVAILABLE)
  joiningDate        DateTime
  bio                String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user               User               @relation(fields: [userId], references: [id])
  department         Department?        @relation(fields: [departmentId], references: [id])
  hospital           Hospital           @relation(fields: [hospitalId], references: [id])
  organization       Organization       @relation(fields: [organizationId], references: [id])
  appointments       Appointment[]
  encounters         Encounter[]
  prescriptions      Prescription[]
  labTests           LabTest[]
  radiologyOrders    RadiologyOrder[]
  schedules          DoctorSchedule[]
  leaves             DoctorLeave[]
  documents          DoctorDocument[]
  admissions         Admission[]
  dischargeFollowUps DischargeSummary[]

  @@unique([registrationNumber, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([hospitalId])
  @@map("doctors")
}

// ─── Provider Scheduling ───────────────────────────────────────────────────
//
// Modeled per-provider-type (Doctor) rather than through a polymorphic
// "Provider" table - see ADR-0006. The *algorithm* in AvailabilityService
// (weekly schedule + leave overlay + shift/break slot slicing) is written
// generically enough that a future provider type (Nurse, Physiotherapist,
// etc.) can stand up its own {Type}Schedule/{Type}ScheduleDay/{Type}Leave
// trio and near-identical service without redesigning the approach.

model DoctorSchedule {
  id             String   @id @default(cuid())
  doctorId       String
  organizationId String
  // The date this version takes effect from. Selecting "the schedule that
  // applies on date X" = the isActive row with the greatest effectiveFrom
  // that is <= X - this lets a new version be created ahead of time
  // (effectiveFrom in the future) without disturbing what's currently in
  // effect, and keeps every prior version in place for history/audit
  // instead of overwriting it in place.
  effectiveFrom  DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id])
  days         DoctorScheduleDay[]

  @@unique([doctorId, effectiveFrom])
  @@index([doctorId])
  @@index([organizationId])
  @@index([doctorId, isActive, effectiveFrom])
  @@map("doctor_schedules")
}

model DoctorScheduleDay {
  id           String   @id @default(cuid())
  scheduleId   String
  dayOfWeek    Weekday
  isWorkingDay Boolean  @default(true)
  // ScheduleShift[] - see packages/types/src/doctor-schedule.ts. Kept as JSON
  // (like Doctor.languagesSpoken/Organization.settings elsewhere in this
  // schema) since a day's shifts+breaks are always read/written together as
  // one unit from the schedule editor, never queried independently.
  shifts       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedule DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
  @@map("doctor_schedule_days")
}

model DoctorLeave {
  id              String      @id @default(cuid())
  doctorId        String
  organizationId  String
  leaveType       LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  reason          String?
  status          LeaveStatus @default(PENDING)
  appliedByUserId String
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([doctorId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([doctorId, startDate, endDate])
  @@map("doctor_leaves")
}

enum DoctorDocumentType {
  MEDICAL_DEGREE
  MEDICAL_LICENSE
  EXPERIENCE_CERTIFICATE
  ID_PROOF
  OTHER
}

model DoctorDocument {
  id             String             @id @default(cuid())
  doctorId       String
  organizationId String
  documentType   DoctorDocumentType
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime           @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_documents")
}

model Staff {
  id               String           @id @default(cuid())
  userId           String           @unique
  employeeId       String
  designation      String
  departmentId     String?
  hospitalId       String
  organizationId   String
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  reportsToId      String?
  joiningDate      DateTime
  dateOfLeaving    DateTime?
  // Monthly gross, used only to derive a per-day rate for unpaid-leave
  // deduction and an hourly rate for overtime in Payroll Prep (see
  // PayrollService) - not a full payroll/compensation-management feature.
  monthlySalary    Decimal?         @db.Decimal(10, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user          User            @relation(fields: [userId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  hospital      Hospital        @relation(fields: [hospitalId], references: [id])
  organization  Organization    @relation(fields: [organizationId], references: [id])
  reportsTo     Staff?          @relation("StaffHierarchy", fields: [reportsToId], references: [id])
  directReports Staff[]         @relation("StaffHierarchy")
  documents     StaffDocument[]
  shiftRosters  ShiftRoster[]
  attendance    Attendance[]
  leaves        StaffLeave[]

  @@unique([employeeId, organizationId])
  @@index([organizationId])
  @@index([hospitalId])
  @@index([departmentId])
  @@index([reportsToId])
  @@map("staff")
}

model StaffDocument {
  id             String            @id @default(cuid())
  staffId        String
  organizationId String
  documentType   StaffDocumentType
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime          @default(now())

  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([staffId])
  @@map("staff_documents")
}

// Shift catalog - org-scoped definitions (a hospital typically has a
// handful: Morning/Afternoon/Night). startTime/endTime are "HH:mm" strings,
// mirroring DoctorScheduleDay's ScheduleShift JSON convention, since a shift
// is always read/written as a whole unit and never queried by time range.
model Shift {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  code               String
  startTime          String
  endTime            String
  breakMinutes       Int      @default(0)
  gracePeriodMinutes Int      @default(15)
  isNightShift       Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  rosters      ShiftRoster[]
  attendance   Attendance[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("shifts")
}

// One row per staff per date - the weekly/rotating roster is just this
// table filtered to a date range and grouped by staff. `isOff` marks an
// explicit day off (week-off) without needing a shift row.
model ShiftRoster {
  id              String   @id @default(cuid())
  staffId         String
  shiftId         String?
  organizationId  String
  date            DateTime @db.Date
  isOff           Boolean  @default(false)
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([staffId, date])
  @@index([organizationId, date])
  @@index([shiftId])
  @@map("shift_rosters")
}

model Attendance {
  id                String           @id @default(cuid())
  staffId           String
  shiftId           String?
  organizationId    String
  date              DateTime         @db.Date
  clockInAt         DateTime?
  clockOutAt        DateTime?
  status            AttendanceStatus @default(ABSENT)
  workedMinutes     Int?
  lateByMinutes     Int?
  notes             String?
  isCorrected       Boolean          @default(false)
  correctedByUserId String?
  correctionReason  String?
  correctedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([staffId, date])
  @@index([organizationId, date])
  @@index([staffId])
  @@map("attendance")
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  date           DateTime @db.Date
  isOptional     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@index([organizationId])
  @@map("holidays")
}

// Per-org, per-leave-type annual quota. Leave *balance* is computed on read
// (annualDays minus the sum of approved StaffLeave day-spans this calendar
// year), not stored as a mutable counter - mirrors this repo's preference
// for computed fields (Vital.bmi, IntakeOutputRecord's balance) over a
// counter that can drift out of sync with the source rows.
model LeaveTypeConfig {
  id             String    @id @default(cuid())
  organizationId String
  leaveType      LeaveType
  annualDays     Int
  isPaid         Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, leaveType])
  @@index([organizationId])
  @@map("leave_type_configs")
}

model StaffLeave {
  id              String      @id @default(cuid())
  staffId         String
  organizationId  String
  leaveType       LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  reason          String?
  status          LeaveStatus @default(PENDING)
  appliedByUserId String
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([staffId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([staffId, startDate, endDate])
  @@map("staff_leaves")
}

// ─── Patient ───────────────────────────────────────────────────────────────

model Patient {
  id                    String      @id @default(cuid())
  uhid                  String
  firstName             String
  lastName              String
  email                 String?
  phone                 String
  dateOfBirth           DateTime
  gender                Gender
  bloodGroup            BloodGroup?
  address               String?
  city                  String?
  state                 String?
  country               String      @default("IN")
  pincode               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  organizationId        String
  metadata              Json        @default("{}")
  isActive              Boolean     @default(true)
  deletedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Family linkage (Milestone 3) - one level deep by design (a head of
  // family cannot itself be someone else's member, enforced in
  // PatientsService, not the DB): every member points at the same head,
  // so listing a family is a single `headOfFamilyId` lookup rather than a
  // graph walk.
  headOfFamilyId String?
  headOfFamily   Patient?  @relation("FamilyMembers", fields: [headOfFamilyId], references: [id])
  familyMembers  Patient[] @relation("FamilyMembers")

  // Patient merge (Milestone 3) - a merged (duplicate) record is soft-
  // deleted and points at the surviving record it was merged into; every
  // other module's patientId column is reassigned to the survivor at merge
  // time (see PatientsService.mergePatients), so this pointer exists purely
  // for provenance/audit, not for read-time redirection.
  mergedIntoId String?
  mergedInto   Patient?  @relation("PatientMerges", fields: [mergedIntoId], references: [id])
  mergedFrom   Patient[] @relation("PatientMerges")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  documents         PatientDocument[]
  appointments      Appointment[]
  encounters        Encounter[]
  prescriptions     Prescription[]
  labTests          LabTest[]
  radiologyOrders   RadiologyOrder[]
  invoices          Invoice[]
  admissions        Admission[]
  insuranceClaims   InsuranceClaim[]
  patientInsurances PatientInsurance[]
  preAuthorizations PreAuthorization[]
  notifications     Notification[]
  dispenseOrders    DispenseOrder[]
  aiConversations   AiConversation[]

  @@unique([uhid, organizationId])
  @@unique([phone, organizationId])
  @@index([organizationId])
  @@index([uhid])
  @@index([phone])
  @@index([headOfFamilyId])
  @@index([mergedIntoId])
  @@map("patients")
}

model PatientDocument {
  id             String       @id @default(cuid())
  patientId      String
  organizationId String
  documentType   DocumentType
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime     @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_documents")
}

// ─── Appointments ──────────────────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String
  patientId         String
  doctorId          String
  departmentId      String?
  organizationId    String
  scheduledAt       DateTime
  durationMinutes   Int               @default(15)
  type              AppointmentType   @default(OPD)
  status            AppointmentStatus @default(SCHEDULED)
  chiefComplaint    String?
  notes             String?
  roomNumber        String?
  referredBy        String?
  // `isWalkIn`/`recurrenceGroupId` - see ADR-0007. A walk-in still has a
  // real `scheduledAt` (the receptionist assigns the next available slot
  // automatically); the flag only distinguishes how it was booked, for
  // reporting/queue-display purposes. `recurrenceGroupId` links every
  // occurrence created from one recurring-booking request - null for a
  // one-off appointment.
  isWalkIn          Boolean           @default(false)
  recurrenceGroupId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  encounter    Encounter?
  labTests     LabTest[]
  invoice      Invoice?
  charges      Charge[]

  @@unique([appointmentNumber, organizationId])
  @@index([organizationId])
  @@index([doctorId, scheduledAt])
  @@index([patientId, organizationId])
  @@index([status, organizationId, scheduledAt])
  @@index([recurrenceGroupId])
  @@map("appointments")
}

// ─── Clinical - EMR (see ADR-0008) ─────────────────────────────────────────
//
// `Encounter` is the longitudinal EMR's central entity - one per
// consultation, created from a completed `Appointment`. Everything a
// clinician records during that consultation hangs off it as its own
// child table (`ClinicalNote`, `Vital`, `Diagnosis`, `Procedure`,
// `EncounterAttachment`) rather than being flat columns on `Encounter`
// itself, so each facet can evolve/be queried independently - most
// importantly `ClinicalNote`, which is append-only (see its own comment).

enum EncounterType {
  OPD
  TELECONSULTATION
  FOLLOW_UP
  EMERGENCY
  WALK_IN
  IPD
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  AMENDED
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

model Encounter {
  id             String          @id @default(cuid())
  patientId      String
  doctorId       String
  appointmentId  String?         @unique
  organizationId String
  type           EncounterType   @default(OPD)
  status         EncounterStatus @default(IN_PROGRESS)
  notes          String?
  encounterDate  DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient           Patient               @relation(fields: [patientId], references: [id])
  doctor            Doctor                @relation(fields: [doctorId], references: [id])
  appointment       Appointment?          @relation(fields: [appointmentId], references: [id])
  organization      Organization          @relation(fields: [organizationId], references: [id])
  clinicalNotes     ClinicalNote[]
  vitals            Vital[]
  diagnoses         Diagnosis[]
  procedures        Procedure[]
  attachments       EncounterAttachment[]
  prescriptions     Prescription[]
  labTests          LabTest[]
  radiologyOrders   RadiologyOrder[]
  invoice           Invoice?
  charges           Charge[]
  preAuthorizations PreAuthorization[]
  insuranceClaims   InsuranceClaim[]
  admissions        Admission[]
  aiConversations   AiConversation[]

  @@index([patientId, organizationId])
  @@index([doctorId, organizationId])
  @@index([organizationId])
  @@map("encounters")
}

/// Append-only: an edit inserts a new row with `version = previous + 1`
/// rather than updating in place - "never overwrite historical notes" is
/// enforced by never exposing an `update` at the service layer, not just
/// by convention. The current note is the highest `version` per encounter.
model ClinicalNote {
  id                      String   @id @default(cuid())
  encounterId             String
  version                 Int
  chiefComplaint          String?
  historyOfPresentIllness String?
  pastMedicalHistory      String?
  familyHistory           String?
  surgicalHistory         String?
  socialHistory           String?
  allergies               String?
  currentMedications      String?
  createdByUserId         String
  createdAt               DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@unique([encounterId, version])
  @@index([encounterId])
  @@map("clinical_notes")
}

model Vital {
  id                     String   @id @default(cuid())
  encounterId            String
  heightCm               Float?
  weightKg               Float?
  /// Computed server-side from height/weight at write time - denormalized
  /// so trend/chart queries don't recompute float math per row.
  bmi                    Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulse                  Int?
  temperatureCelsius     Float?
  respiratoryRate        Int?
  spo2                   Int?
  recordedByUserId       String
  recordedAt             DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("vitals")
}

model Diagnosis {
  id          String        @id @default(cuid())
  encounterId String
  type        DiagnosisType @default(PRIMARY)
  description String
  /// Placeholder, not a validated lookup against a real ICD-10 terminology
  /// service - see ADR-0008/TECH_DEBT.
  icdCode     String?
  createdAt   DateTime      @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("diagnoses")
}

model Procedure {
  id          String   @id @default(cuid())
  encounterId String
  name        String
  notes       String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("procedures")
}

enum EncounterAttachmentType {
  CLINICAL_DOCUMENT
  IMAGE
  EXTERNAL_REPORT
  OTHER
}

model EncounterAttachment {
  id             String                  @id @default(cuid())
  encounterId    String
  organizationId String
  documentType   EncounterAttachmentType @default(OTHER)
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime                @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("encounter_attachments")
}

model Prescription {
  id                 String             @id @default(cuid())
  prescriptionNumber String
  patientId          String
  doctorId           String
  encounterId        String?
  organizationId     String
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  prescribedAt       DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  patient          Patient            @relation(fields: [patientId], references: [id])
  doctor           Doctor             @relation(fields: [doctorId], references: [id])
  encounter        Encounter?         @relation(fields: [encounterId], references: [id])
  organization     Organization       @relation(fields: [organizationId], references: [id])
  items            PrescriptionItem[]
  dispenseOrder    DispenseOrder?
  dischargeSummary DischargeSummary?

  @@unique([prescriptionNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  medicationName String
  genericName    String?
  strength       String?
  form           String?
  dosage         String
  frequency      String
  duration       String
  route          String   @default("ORAL")
  instructions   String?
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  prescription    Prescription               @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  dispenseItem    DispenseItem?
  administrations MedicationAdministration[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ─── Laboratory ────────────────────────────────────────────────────────────

/// Org-scoped, configurable catalog of orderable lab tests - see ADR-0012.
/// Supports both a numeric reference range (`referenceRangeLow`/`High`, used
/// for automatic abnormal-value flagging) and a free-text range (for
/// qualitative tests like "Negative"/"Non-reactive" where a numeric bound
/// makes no sense) - either or both may be set. `criticalLow`/`criticalHigh`
/// are optional explicit critical thresholds; when absent, callers fall back
/// to a documented multiplier of the normal range (see `abnormal-flagging.ts`).
model LabTestCatalogItem {
  id                 String   @id @default(cuid())
  organizationId     String
  testCode           String
  testName           String
  category           String
  unit               String?
  referenceRangeLow  Float?
  referenceRangeHigh Float?
  referenceRangeText String?
  criticalLow        Float?
  criticalHigh       Float?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        LabTestItem[]

  @@unique([organizationId, testCode])
  @@index([organizationId])
  @@map("lab_test_catalog_items")
}

model LabTest {
  id                String        @id @default(cuid())
  labOrderNumber    String
  patientId         String
  doctorId          String
  appointmentId     String?
  encounterId       String?
  organizationId    String
  status            LabTestStatus @default(ORDERED)
  priority          Priority      @default(ROUTINE)
  sampleCollectedBy String?
  sampleCollectedAt DateTime?
  reportedAt        DateTime?
  reportFileUrl     String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  encounter    Encounter?    @relation(fields: [encounterId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  items        LabTestItem[]

  @@unique([labOrderNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([encounterId])
  @@map("lab_tests")
}

model LabTestItem {
  id                 String        @id @default(cuid())
  labTestId          String
  catalogItemId      String?
  testName           String
  testCode           String
  category           String
  result             String?
  unit               String?
  referenceRange     String?
  /// Denormalized from the catalog item (or explicit ad-hoc bounds) at order
  /// time, not looked up again at result-entry time - so a later edit or
  /// deactivation of the catalog item never changes how an already-ordered
  /// item's abnormal flag is computed. See `abnormal-flagging.ts`.
  referenceRangeLow  Float?
  referenceRangeHigh Float?
  criticalLow        Float?
  criticalHigh       Float?
  isAbnormal         Boolean       @default(false)
  abnormalType       AbnormalType?
  interpretation     String?
  createdAt          DateTime      @default(now())

  labTest     LabTest             @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  catalogItem LabTestCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([labTestId])
  @@index([catalogItemId])
  @@map("lab_test_items")
}

// ─── Radiology ─────────────────────────────────────────────────────────────

/// Org-configurable catalog of orderable radiology studies (Milestone 8,
/// mirrors LabTestCatalogItem's shape/role - ADR-0013). `modality`/`bodyPart`
/// stay free-text `String` (not enums), matching the pre-existing
/// `RadiologyOrder.modality`/`bodyPart` columns from the original scaffold -
/// real-world modality vocabularies (DICOM's CR/CT/MR/US/MG/NM/PT/XA/...)
/// are broad and this keeps the door open for a future PACS integration to
/// supply its own values without a schema change.
model RadiologyCatalogItem {
  id                       String   @id @default(cuid())
  organizationId           String
  code                     String
  name                     String
  category                 String
  modality                 String
  bodyPart                 String
  contrastRequired         Boolean  @default(false)
  price                    Decimal  @db.Decimal(10, 2)
  estimatedDurationMinutes Int
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  orders       RadiologyOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("radiology_catalog_items")
}

model RadiologyOrder {
  id                 String          @id @default(cuid())
  orderNumber        String
  patientId          String
  doctorId           String
  encounterId        String?
  catalogItemId      String?
  organizationId     String
  modality           String
  bodyPart           String
  clinicalIndication String?
  status             RadiologyStatus @default(ORDERED)
  priority           Priority        @default(ROUTINE)

  // Scheduling - appointment date/time, room, machine, and staff assignment.
  // `technicianUserId` stays a plain String (no FK), matching the existing
  // "actor" convention (ADR-0008 point 5, e.g. LabTest.sampleCollectedBy) -
  // there is no dedicated RadiologyTechnician profile model, just a User
  // with the RADIOLOGY_TECHNICIAN system role. `radiologistDoctorId` is a
  // real FK to Doctor since a radiologist is a Doctor profile (by
  // specialization), the same reuse `LabTest.doctorId` already relies on.
  scheduledAt         DateTime?
  room                String?
  machine             String?
  technicianUserId    String?
  radiologistDoctorId String?
  durationMinutes     Int?

  // Report - current/released snapshot, denormalized from the latest
  // RadiologyReport version below for cheap reads (list/queue views) without
  // an extra join; the versioned history itself lives in `reports`.
  technique        String?
  findings         String?
  impression       String?
  recommendations  String?
  reportFileUrl    String?
  reportedBy       String?
  reportedAt       DateTime?
  verifiedByUserId String?
  verifiedAt       DateTime?
  releasedByUserId String?
  releasedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      Patient               @relation(fields: [patientId], references: [id])
  doctor       Doctor                @relation(fields: [doctorId], references: [id])
  encounter    Encounter?            @relation(fields: [encounterId], references: [id])
  catalogItem  RadiologyCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  organization Organization          @relation(fields: [organizationId], references: [id])
  reports      RadiologyReport[]
  attachments  RadiologyAttachment[]

  @@unique([orderNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([encounterId])
  @@map("radiology_orders")
}

/// Append-only, versioned radiology report - same "never overwrite" pattern
/// as `ClinicalNote` (ADR-0008): an edit inserts a new row with
/// `version = previous + 1` rather than updating in place. The current
/// (highest-version) row's content is denormalized onto `RadiologyOrder`
/// itself for cheap reads; verification/release act on that current version.
model RadiologyReport {
  id                 String   @id @default(cuid())
  radiologyOrderId   String
  version            Int
  clinicalIndication String?
  technique          String?
  findings           String?
  impression         String?
  recommendations    String?
  createdByUserId    String?
  createdAt          DateTime @default(now())

  radiologyOrder RadiologyOrder @relation(fields: [radiologyOrderId], references: [id], onDelete: Cascade)

  @@index([radiologyOrderId])
  @@map("radiology_reports")
}

/// Image/document attachments for a radiology order. `EXTERNAL_IMAGING` and
/// `DICOM_PLACEHOLDER` support a study referenced from an outside PACS/imaging
/// center without a real file (metadata-only - accession number, external
/// URL, study instance UID placeholder); `IMAGE`/`PDF` require a real
/// uploaded file via the existing `StorageService`. No real PACS/DICOM server
/// integration exists - see TECH_DEBT.
model RadiologyAttachment {
  id               String                  @id @default(cuid())
  radiologyOrderId String
  organizationId   String
  type             RadiologyAttachmentType @default(OTHER)
  fileName         String?
  fileUrl          String?
  mimeType         String?
  fileSizeBytes    Int?
  metadata         Json?
  uploadedByUserId String?
  uploadedAt       DateTime                @default(now())

  radiologyOrder RadiologyOrder @relation(fields: [radiologyOrderId], references: [id], onDelete: Cascade)

  @@index([radiologyOrderId])
  @@map("radiology_attachments")
}

// ─── Inpatient ─────────────────────────────────────────────────────────────
// Hierarchy: Ward -> Room -> Bed. `Bed`/`Admission` denormalize `wardId`
// alongside the room-level FK so ward-scoped occupancy queries (dashboard,
// bed grid) don't need a join through Room - see ADR-0018.

model Ward {
  id             String     @id @default(cuid())
  name           String
  code           String
  floor          String?
  block          String?
  type           WardType   @default(GENERAL)
  departmentId   String?
  organizationId String
  status         WardStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  department    Department?   @relation(fields: [departmentId], references: [id])
  rooms         Room[]
  beds          Bed[]
  admissions    Admission[]
  transfersFrom BedTransfer[] @relation("TransferFromWard")
  transfersTo   BedTransfer[] @relation("TransferToWard")

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@map("wards")
}

model Room {
  id             String     @id @default(cuid())
  roomNumber     String
  wardId         String
  organizationId String
  floor          String?
  capacity       Int        @default(1)
  chargesPerDay  Decimal    @db.Decimal(10, 2)
  status         RoomStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  ward          Ward          @relation(fields: [wardId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])
  beds          Bed[]
  admissions    Admission[]
  transfersFrom BedTransfer[] @relation("TransferFromRoom")
  transfersTo   BedTransfer[] @relation("TransferToRoom")

  @@unique([roomNumber, wardId])
  @@index([organizationId])
  @@index([wardId])
  @@map("rooms")
}

model Bed {
  id             String    @id @default(cuid())
  bedNumber      String
  roomId         String
  wardId         String
  organizationId String
  type           BedType   @default(GENERAL)
  status         BedStatus @default(AVAILABLE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  room          Room            @relation(fields: [roomId], references: [id])
  ward          Ward            @relation(fields: [wardId], references: [id])
  organization  Organization    @relation(fields: [organizationId], references: [id])
  admissions    Admission[]
  allocations   BedAllocation[]
  transfersFrom BedTransfer[]   @relation("TransferFromBed")
  transfersTo   BedTransfer[]   @relation("TransferToBed")

  @@unique([bedNumber, roomId])
  @@index([organizationId])
  @@index([wardId, status])
  @@index([roomId])
  @@map("beds")
}

/// The scaffolded field names (`admissionNumber`/`admissionReason`/
/// `admittedAt`/`status`/`patientId`) predate this checkpoint and are
/// already read by `patients.service.ts`'s timeline/summary queries - kept
/// unchanged so that code (out of scope for this checkpoint) keeps working.
model Admission {
  id                        String          @id @default(cuid())
  admissionNumber           String
  patientId                 String
  encounterId               String?
  attendingDoctorId         String
  departmentId              String?
  wardId                    String
  roomId                    String?
  bedId                     String?
  patientInsuranceId        String?
  organizationId            String
  type                      AdmissionType   @default(SCHEDULED)
  status                    AdmissionStatus @default(ADMITTED)
  admissionReason           String
  diagnosis                 String?
  admittedAt                DateTime        @default(now())
  expectedDischargeAt       DateTime?
  dischargedAt              DateTime?
  dischargeNotes            String?
  dischargeCondition        String?
  /// Set when the attending doctor approves discharge (Checkpoint 12.2) -
  /// admission stays `ADMITTED` ("pending discharge") until the nursing
  /// checklist is complete and `completeDischarge` finalizes it.
  dischargeApprovedAt       DateTime?
  dischargeApprovedByUserId String?
  cancelledAt               DateTime?
  cancelReason              String?
  createdByUserId           String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  patient                   Patient                    @relation(fields: [patientId], references: [id])
  encounter                 Encounter?                 @relation(fields: [encounterId], references: [id])
  attendingDoctor           Doctor                     @relation(fields: [attendingDoctorId], references: [id])
  department                Department?                @relation(fields: [departmentId], references: [id])
  ward                      Ward                       @relation(fields: [wardId], references: [id])
  room                      Room?                      @relation(fields: [roomId], references: [id])
  bed                       Bed?                       @relation(fields: [bedId], references: [id])
  patientInsurance          PatientInsurance?          @relation(fields: [patientInsuranceId], references: [id])
  organization              Organization               @relation(fields: [organizationId], references: [id])
  allocations               BedAllocation[]
  transfers                 BedTransfer[]
  nursingNotes              NursingNote[]
  nursingAssessments        NursingAssessment[]
  intakeOutputRecords       IntakeOutputRecord[]
  ipdOrders                 IpdOrder[]
  nursingTasks              NursingTask[]
  medicationAdministrations MedicationAdministration[]
  dischargeChecklistItems   DischargeChecklistItem[]
  dischargeSummary          DischargeSummary?

  @@unique([admissionNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId, status])
  @@index([bedId])
  @@index([wardId])
  @@map("admissions")
}

/// One row per allocate/reserve/vacate/reservation-cancel event against a
/// single bed - the audit trail for "Bed Allocation" (ADR-0018). A transfer
/// is recorded separately in `BedTransfer` so the UI can render it as one
/// from→to row rather than reconstructing it from a vacate+allocate pair.
model BedAllocation {
  id                String              @id @default(cuid())
  admissionId       String
  bedId             String
  organizationId    String
  action            BedAllocationAction
  performedByUserId String?
  reason            String?
  occurredAt        DateTime            @default(now())

  admission    Admission    @relation(fields: [admissionId], references: [id])
  bed          Bed          @relation(fields: [bedId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([admissionId])
  @@index([bedId])
  @@index([organizationId])
  @@map("bed_allocations")
}

/// A bed/room/ward transfer during a single admission, tracked as its own
/// from→to record rather than derived from `BedAllocation` rows.
model BedTransfer {
  id                  String   @id @default(cuid())
  admissionId         String
  organizationId      String
  fromBedId           String?
  toBedId             String
  fromRoomId          String?
  toRoomId            String?
  fromWardId          String?
  toWardId            String
  reason              String?
  transferredByUserId String?
  transferredAt       DateTime @default(now())

  admission    Admission    @relation(fields: [admissionId], references: [id])
  fromBed      Bed?         @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toBed        Bed          @relation("TransferToBed", fields: [toBedId], references: [id])
  fromRoom     Room?        @relation("TransferFromRoom", fields: [fromRoomId], references: [id])
  toRoom       Room?        @relation("TransferToRoom", fields: [toRoomId], references: [id])
  fromWard     Ward?        @relation("TransferFromWard", fields: [fromWardId], references: [id])
  toWard       Ward         @relation("TransferToWard", fields: [toWardId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([admissionId])
  @@index([organizationId])
  @@map("bed_transfers")
}

// ─── Nursing, MAR & Discharge - Milestone 12, Checkpoint 12.2 ─────────────
// Nursing notes/assessments/I-O charting/orders/tasks are admission-scoped
// rather than encounter-scoped like `ClinicalNote`/`Vital` - IPD nursing
// documentation is materially higher-frequency (multiple entries per shift)
// and nurse-authored, a genuinely distinct workflow from the doctor-
// authored, per-consultation EMR entities in medical-records (see NEXT.md's
// judgment-call framing / DECISIONS.md ADR-0019). Vitals charting reuses
// the existing encounter-scoped `Vital` model as-is via the admission's
// `encounterId` - no new model needed there. MAR reuses
// `Prescription`/`PrescriptionItem` as the source of truth for what's
// prescribed, with `MedicationAdministration` as the admin-log child table,
// mirroring `DispenseOrder`/`DispenseItem`'s precedent rather than a
// parallel prescribing model.

enum NursingNoteType {
  GENERAL
  SHIFT_HANDOVER
  ASSESSMENT
  INCIDENT
}

enum FallRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum PressureUlcerRiskLevel {
  LOW
  MODERATE
  HIGH
  SEVERE
}

enum IpdOrderCategory {
  DIET
  FLUID
  ACTIVITY
  OXYGEN
  ISOLATION
}

enum IpdOrderStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum NursingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum NursingTaskPriority {
  ROUTINE
  URGENT
  STAT
}

enum MedicationAdministrationType {
  SCHEDULED
  PRN
  STAT
}

enum MedicationAdministrationStatus {
  PENDING
  ADMINISTERED
  MISSED
  REFUSED
  HELD
  DELAYED
  CANCELLED
}

enum DischargeChecklistItemKey {
  VITALS_STABLE
  MEDICATION_RECONCILIATION_DONE
  PATIENT_EDUCATION_GIVEN
  BELONGINGS_RETURNED
  WOUND_CARE_INSTRUCTIONS_GIVEN
  EQUIPMENT_RETURNED
  FOLLOWUP_EXPLAINED
  TRANSPORT_ARRANGED
}

/// Free-text nursing note, admission-scoped - covers general notes, shift
/// handover, and ad hoc assessment narratives. `isEscalated` is the
/// "escalation flag" scope item: a nurse flags a note for physician
/// attention without a separate notification/paging system (none exists in
/// this repo).
model NursingNote {
  id               String          @id @default(cuid())
  admissionId      String
  organizationId   String
  type             NursingNoteType @default(GENERAL)
  shift            ShiftType?
  content          String
  isEscalated      Boolean         @default(false)
  escalationReason String?
  createdByUserId  String
  createdAt        DateTime        @default(now())

  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([admissionId])
  @@index([organizationId])
  @@map("nursing_notes")
}

/// One consolidated structured assessment row per charting event - pain
/// score, fall risk (Morse-style score + derived level), Braden pressure-
/// ulcer risk (score + derived level), Glasgow Coma Scale (eye/verbal/motor
/// + server-computed total), and free-text daily-assessment notes.
/// Mirrors `Vital`'s "one row, many fields" shape rather than one model per
/// scale.
model NursingAssessment {
  id               String                  @id @default(cuid())
  admissionId      String
  organizationId   String
  painScore        Int?
  fallRiskScore    Int?
  fallRiskLevel    FallRiskLevel?
  bradenScore      Int?
  bradenRiskLevel  PressureUlcerRiskLevel?
  gcsEye           Int?
  gcsVerbal        Int?
  gcsMotor         Int?
  /// Computed server-side from eye+verbal+motor at write time, mirroring
  /// `Vital.bmi`'s denormalized-computed-field precedent.
  gcsTotal         Int?
  generalNotes     String?
  assessedByUserId String
  assessedAt       DateTime                @default(now())

  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([admissionId])
  @@index([organizationId])
  @@map("nursing_assessments")
}

/// Intake/Output chart - one row per recording event.
model IntakeOutputRecord {
  id               String   @id @default(cuid())
  admissionId      String
  organizationId   String
  recordedAt       DateTime @default(now())
  oralIntakeMl     Int?
  ivFluidIntakeMl  Int?
  otherIntakeMl    Int?
  urineOutputMl    Int?
  stoolOutputCount Int?
  vomitusMl        Int?
  drainOutputMl    Int?
  otherOutputMl    Int?
  notes            String?
  recordedByUserId String

  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([admissionId])
  @@index([organizationId])
  @@map("intake_output_records")
}

/// A doctor's order against an admission - diet/fluid/activity/oxygen/
/// isolation-precaution instructions. Distinct from `NursingTask` (the
/// nurse-facing to-do it may spawn) and from `Prescription` (medication
/// orders, handled through MAR instead).
model IpdOrder {
  id                   String           @id @default(cuid())
  admissionId          String
  organizationId       String
  category             IpdOrderCategory
  instructions         String
  status               IpdOrderStatus   @default(ACTIVE)
  orderedByUserId      String
  startedAt            DateTime         @default(now())
  discontinuedAt       DateTime?
  discontinuedReason   String?
  discontinuedByUserId String?
  createdAt            DateTime         @default(now())

  admission    Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id])
  nursingTasks NursingTask[]

  @@index([admissionId])
  @@index([organizationId])
  @@map("ipd_orders")
}

/// A nursing to-do item - either standalone (a nurse's own checklist entry)
/// or spawned from an `IpdOrder` (`sourceOrderId`). Backs the "Pending
/// nursing tasks" dashboard stat and the `/dashboard/nursing/tasks` queue.
model NursingTask {
  id                String              @id @default(cuid())
  admissionId       String
  organizationId    String
  sourceOrderId     String?
  title             String
  description       String?
  priority          NursingTaskPriority @default(ROUTINE)
  dueAt             DateTime?
  status            NursingTaskStatus   @default(PENDING)
  assignedToUserId  String?
  completedByUserId String?
  completedAt       DateTime?
  completionNotes   String?
  createdByUserId   String?
  createdAt         DateTime            @default(now())

  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  sourceOrder  IpdOrder?    @relation(fields: [sourceOrderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([admissionId])
  @@index([organizationId, status])
  @@map("nursing_tasks")
}

/// Medication Administration Record row - one per scheduled/PRN/STAT dose
/// instance for a `PrescriptionItem` during an admission. `barcodeVerified`/
/// `scannedCode` are the barcode-ready architecture hook (no physical
/// scanner hardware/integration exists in this repo - see TECH_DEBT).
/// `nurseSignature` is a typed-name attestation, not a cryptographic
/// signature. The full administration audit trail is the existing
/// `AuditLog` (via `AuditListener`), not a duplicate log table.
model MedicationAdministration {
  id                   String                         @id @default(cuid())
  admissionId          String
  prescriptionItemId   String
  organizationId       String
  type                 MedicationAdministrationType   @default(SCHEDULED)
  scheduledAt          DateTime
  administeredAt       DateTime?
  status               MedicationAdministrationStatus @default(PENDING)
  doseGiven            String?
  route                String?
  notes                String?
  barcodeVerified      Boolean                        @default(false)
  scannedCode          String?
  administeredByUserId String?
  nurseSignature       String?
  createdByUserId      String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  admission        Admission        @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id])

  @@index([admissionId])
  @@index([prescriptionItemId])
  @@index([organizationId, status])
  @@map("medication_administrations")
}

/// One row per discharge-checklist item, seeded (idempotently) when a
/// doctor approves discharge. Every row must be `completed` before
/// `AdmissionsService.completeDischarge` can finalize.
model DischargeChecklistItem {
  id                String                    @id @default(cuid())
  admissionId       String
  organizationId    String
  itemKey           DischargeChecklistItemKey
  completed         Boolean                   @default(false)
  completedByUserId String?
  completedAt       DateTime?
  notes             String?
  createdAt         DateTime                  @default(now())

  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([admissionId, itemKey])
  @@index([admissionId])
  @@map("discharge_checklist_items")
}

/// The discharge summary document - final diagnosis, hospital course,
/// medication reconciliation, follow-up instructions/appointment, and a
/// link to the discharge prescription (a normal `Prescription` row tagged
/// by this FK rather than a parallel model). One per admission; drafted
/// after doctor approval, finalized (immutable in spirit, not enforced at
/// the DB level) once discharge completes.
model DischargeSummary {
  id                       String    @id @default(cuid())
  admissionId              String    @unique
  organizationId           String
  finalDiagnosis           String
  courseInHospital         String?
  proceduresPerformed      String?
  conditionAtDischarge     String?
  medicationReconciliation String?
  followUpInstructions     String?
  followUpAppointmentAt    DateTime?
  followUpDoctorId         String?
  dischargePrescriptionId  String?   @unique
  preparedByUserId         String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  admission             Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  organization          Organization  @relation(fields: [organizationId], references: [id])
  followUpDoctor        Doctor?       @relation(fields: [followUpDoctorId], references: [id])
  dischargePrescription Prescription? @relation(fields: [dischargePrescriptionId], references: [id])

  @@index([organizationId])
  @@map("discharge_summaries")
}

// ─── Billing ───────────────────────────────────────────────────────────────

model Invoice {
  id                        String                 @id @default(cuid())
  invoiceNumber             String
  patientId                 String
  appointmentId             String?                @unique
  encounterId               String?                @unique
  organizationId            String
  status                    InvoiceStatus          @default(DRAFT)
  type                      InvoiceType            @default(OPD)
  subtotal                  Decimal                @db.Decimal(12, 2)
  discountAmount            Decimal                @default(0) @db.Decimal(12, 2)
  taxAmount                 Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount               Decimal                @db.Decimal(12, 2)
  paidAmount                Decimal                @default(0) @db.Decimal(12, 2)
  balanceDue                Decimal                @db.Decimal(12, 2)
  currency                  String                 @default("INR")
  notes                     String?
  dueDate                   DateTime?
  createdByUserId           String?
  // Discount workflow - see ADR-0015. A discount applied by a `billing.manage`
  // scope holder is auto-approved; anyone else's request lands `PENDING`
  // until a manage-scope holder approves/rejects it. Only an `APPROVED`
  // discount is ever reflected in `discountAmount`/`totalAmount`/`balanceDue`.
  discountType              DiscountType?
  discountValue             Decimal?               @db.Decimal(10, 2)
  discountReason            String?
  discountApprovalStatus    DiscountApprovalStatus @default(NONE)
  discountRequestedByUserId String?
  discountApprovedByUserId  String?
  discountApprovedAt        DateTime?
  finalizedAt               DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  encounter      Encounter?      @relation(fields: [encounterId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  refunds        Refund[]
  charges        Charge[]
  insuranceClaim InsuranceClaim?

  @@unique([invoiceNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([status, organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  itemName        String
  itemCode        String?
  category        String
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String
  invoiceId       String
  patientId       String
  organizationId  String
  amount          Decimal       @db.Decimal(12, 2)
  paymentMode     PaymentMode
  transactionId   String?
  referenceNumber String?
  status          PaymentStatus @default(COMPLETED)
  collectedBy     String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  refunds Refund[]

  @@unique([paymentNumber, organizationId])
  @@index([invoiceId])
  @@index([patientId, organizationId])
  @@map("payments")
}

/// See ADR-0016. `insuranceProvider`/`policyNumber` are denormalized at
/// claim-creation time from the resolved `InsuranceProvider`/
/// `PatientInsurance` (the same "denormalize at order time" idiom as
/// `LabTestItem`/`RadiologyOrder`) - kept as the original scaffold's
/// required display fields rather than dropped, since a claim must always
/// show a provider name/policy number even if the structured records
/// backing it are later edited or deactivated.
model InsuranceClaim {
  id                 String               @id @default(cuid())
  claimNumber        String
  patientId          String
  invoiceId          String               @unique
  encounterId        String
  organizationId     String
  providerId         String?
  planId             String?
  patientInsuranceId String?
  preAuthorizationId String?              @unique
  insuranceProvider  String
  policyNumber       String
  membershipId       String?
  claimedAmount      Decimal              @db.Decimal(12, 2)
  approvedAmount     Decimal?             @db.Decimal(12, 2)
  rejectedAmount     Decimal?             @db.Decimal(12, 2)
  insuranceShare     Decimal?             @db.Decimal(12, 2)
  patientShare       Decimal?             @db.Decimal(12, 2)
  adjustmentAmount   Decimal              @default(0) @db.Decimal(12, 2)
  writeOffAmount     Decimal              @default(0) @db.Decimal(12, 2)
  outstandingAmount  Decimal?             @db.Decimal(12, 2)
  paymentStatus      ClaimPaymentStatus   @default(PENDING)
  status             InsuranceClaimStatus @default(DRAFT)
  rejectionReason    String?
  submittedAt        DateTime?
  settledAt          DateTime?
  closedAt           DateTime?
  createdByUserId    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  patient          Patient            @relation(fields: [patientId], references: [id])
  invoice          Invoice            @relation(fields: [invoiceId], references: [id])
  encounter        Encounter          @relation(fields: [encounterId], references: [id])
  organization     Organization       @relation(fields: [organizationId], references: [id])
  provider         InsuranceProvider? @relation(fields: [providerId], references: [id])
  plan             InsurancePlan?     @relation(fields: [planId], references: [id])
  patientInsurance PatientInsurance?  @relation(fields: [patientInsuranceId], references: [id])
  preAuthorization PreAuthorization?  @relation(fields: [preAuthorizationId], references: [id])
  documents        ClaimDocument[]

  @@unique([claimNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([status, organizationId])
  @@map("insurance_claims")
}

/// Insurance Company / TPA / Corporate Plan issuer - see ADR-0016.
model InsuranceProvider {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  code           String
  type           InsuranceProviderType @default(INSURANCE_COMPANY)
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  plans             InsurancePlan[]
  patientInsurances PatientInsurance[]
  claims            InsuranceClaim[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("insurance_providers")
}

/// A provider's plan - coverage terms a `PatientInsurance` enrollment
/// inherits by default (a patient-level `coveragePercent` override is still
/// possible on `PatientInsurance` itself for a negotiated exception).
model InsurancePlan {
  id              String               @id @default(cuid())
  organizationId  String
  providerId      String
  name            String
  code            String
  coveragePercent Decimal              @default(100) @db.Decimal(5, 2)
  coPayPercent    Decimal              @default(0) @db.Decimal(5, 2)
  deductible      Decimal              @default(0) @db.Decimal(12, 2)
  annualLimit     Decimal?             @db.Decimal(12, 2)
  perVisitLimit   Decimal?             @db.Decimal(12, 2)
  networkType     InsuranceNetworkType @default(CASHLESS)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  provider          InsuranceProvider  @relation(fields: [providerId], references: [id])
  patientInsurances PatientInsurance[]
  claims            InsuranceClaim[]

  @@unique([organizationId, providerId, code])
  @@index([organizationId])
  @@index([providerId])
  @@map("insurance_plans")
}

/// A patient's enrollment in a plan - "each patient may have Primary
/// Insurance, Secondary Insurance" (see ADR-0016). No DB-level constraint
/// enforces "only one ACTIVE primary at a time" - application code does,
/// leaving room for a patient's insurance history (expired enrollments)
/// to stay queryable rather than being overwritten.
model PatientInsurance {
  id              String                 @id @default(cuid())
  organizationId  String
  patientId       String
  providerId      String
  planId          String
  type            PatientInsuranceType   @default(PRIMARY)
  memberId        String
  policyNumber    String
  effectiveDate   DateTime
  expiryDate      DateTime?
  coveragePercent Decimal?               @db.Decimal(5, 2)
  status          PatientInsuranceStatus @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  provider          InsuranceProvider  @relation(fields: [providerId], references: [id])
  plan              InsurancePlan      @relation(fields: [planId], references: [id])
  preAuthorizations PreAuthorization[]
  claims            InsuranceClaim[]
  admissions        Admission[]

  @@index([organizationId, patientId])
  @@map("patient_insurances")
}

/// Cashless/TPA pre-authorization request against a specific encounter -
/// see ADR-0016. A settled claim can (optionally) trace back to the
/// pre-auth that cleared it via `InsuranceClaim.preAuthorizationId`.
model PreAuthorization {
  id                 String                 @id @default(cuid())
  authNumber         String
  organizationId     String
  patientId          String
  encounterId        String
  patientInsuranceId String
  status             PreAuthorizationStatus @default(DRAFT)
  clinicalNotes      String?
  doctorNotes        String?
  requestedAmount    Decimal                @db.Decimal(12, 2)
  approvedAmount     Decimal?               @db.Decimal(12, 2)
  rejectionReason    String?
  submittedAt        DateTime?
  decidedAt          DateTime?
  decidedByUserId    String?
  createdByUserId    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id])
  patient          Patient             @relation(fields: [patientId], references: [id])
  encounter        Encounter           @relation(fields: [encounterId], references: [id])
  patientInsurance PatientInsurance    @relation(fields: [patientInsuranceId], references: [id])
  attachments      PreAuthAttachment[]
  claim            InsuranceClaim?

  @@unique([authNumber, organizationId])
  @@index([organizationId, patientId])
  @@map("pre_authorizations")
}

model PreAuthAttachment {
  id                 String   @id @default(cuid())
  preAuthorizationId String
  fileName           String
  fileUrl            String
  mimeType           String
  size               Int
  uploadedByUserId   String
  createdAt          DateTime @default(now())

  preAuthorization PreAuthorization @relation(fields: [preAuthorizationId], references: [id], onDelete: Cascade)

  @@index([preAuthorizationId])
  @@map("pre_auth_attachments")
}

/// A claim's supporting documents - auto-attached from other modules'
/// existing PDF generators (invoice, prescription, lab/radiology reports,
/// a new encounter-summary generator) at claim-creation time, plus manual
/// uploads via the existing `StorageService` - see ADR-0016.
model ClaimDocument {
  id               String            @id @default(cuid())
  claimId          String
  organizationId   String
  type             ClaimDocumentType
  fileName         String
  fileUrl          String
  autoAttached     Boolean           @default(false)
  uploadedByUserId String?
  createdAt        DateTime          @default(now())

  claim InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_documents")
}

/// Configurable pricing catalog ("service catalog with pricing") - see
/// ADR-0015. `category` stays free-text (mirrors `RadiologyCatalogItem
/// .modality`/`bodyPart`'s precedent) rather than an enum, since billable
/// service categories vary per organization. `taxPercent` defaults from
/// `Organization.settings.gstRate` at creation time, editable per item.
model ServiceCatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  category       String
  price          Decimal  @db.Decimal(10, 2)
  taxPercent     Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  charges      Charge[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("service_catalog_items")
}

/// The reusable Charge Engine entity - see ADR-0015. Every clinical module
/// (or a manual cashier action) creates one `Charge` row; invoice generation
/// (auto from a completed appointment, or manual) sweeps every `PENDING`
/// charge for a patient/encounter into `InvoiceItem` rows and flips them to
/// `INVOICED`. Denormalizes `description`/`unitPrice`/`taxPercent` at
/// creation time (from the catalog item or ad-hoc) - the same "denormalize
/// at order time" idiom as `LabTestItem`/`RadiologyOrder`/`DispenseItem`, so
/// a later catalog edit never retroactively changes an already-billed charge.
model Charge {
  id              String             @id @default(cuid())
  organizationId  String
  patientId       String
  encounterId     String?
  appointmentId   String?
  sourceModule    ChargeSourceModule @default(MISCELLANEOUS)
  sourceId        String?
  catalogItemId   String?
  description     String
  quantity        Int                @default(1)
  unitPrice       Decimal            @db.Decimal(10, 2)
  discountPercent Decimal            @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal            @default(0) @db.Decimal(10, 2)
  taxPercent      Decimal            @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal            @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  status          ChargeStatus       @default(PENDING)
  invoiceId       String?
  createdByUserId String?
  createdAt       DateTime           @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  encounter    Encounter?          @relation(fields: [encounterId], references: [id])
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id])
  catalogItem  ServiceCatalogItem? @relation(fields: [catalogItemId], references: [id])
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, patientId])
  @@index([status, organizationId])
  @@index([encounterId])
  @@index([appointmentId])
  @@map("charges")
}

/// Partial or full refund against a `Payment`/`Invoice` - see ADR-0015. A
/// `billing.manage` scope holder's request is auto-approved+completed;
/// anyone else's lands `PENDING` until a manage-scope holder approves it -
/// the same approval-workflow shape as `Invoice`'s discount fields.
model Refund {
  id                String       @id @default(cuid())
  refundNumber      String
  organizationId    String
  invoiceId         String
  paymentId         String?
  amount            Decimal      @db.Decimal(12, 2)
  reason            String
  refundMode        PaymentMode?
  status            RefundStatus @default(PENDING)
  requestedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  refundedAt        DateTime?
  createdAt         DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@unique([refundNumber, organizationId])
  @@index([invoiceId])
  @@index([organizationId, status])
  @@map("refunds")
}

// ─── Pharmacy & Inventory ──────────────────────────────────────────────────

// ─── Pharmacy ───────────────────────────────────────────────────────────────

enum DispenseStatus {
  PENDING
  PREPARING
  READY
  DISPENSED
  CANCELLED
  RETURNED
}

/// Org-scoped pharmacy catalog - see ADR-0014. One row is one batch of a
/// drug: batch number and expiry are first-class catalog fields (per the
/// roadmap's own "Drug Catalog CRUD Fields" list), not a separate child
/// table - restocking the same generic/brand drug with a new batch creates
/// a new `Drug` row rather than a join. Replaces the unused `Medication`
/// model from the original scaffolding commit (confirmed zero references
/// anywhere before this milestone), whose shape was missing brand name,
/// batch, expiry, tax, and stock-level fields.
model Drug {
  id             String   @id @default(cuid())
  organizationId String
  genericName    String
  brandName      String?
  strength       String?
  dosageForm     String
  manufacturer   String?
  batchNumber    String
  expiryDate     DateTime
  price          Decimal  @default(0) @db.Decimal(10, 2)
  taxPercent     Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  /// Physical quantity on hand, including any reserved portion.
  currentStock   Int      @default(0)
  /// Portion of `currentStock` earmarked by an in-progress `DispenseOrder`
  /// (status `PREPARING`/`READY`) - not yet deducted. See ADR-0014 point 6.
  reservedStock  Int      @default(0)
  minStockLevel  Int      @default(10)
  reorderLevel   Int      @default(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  dispenseItems DispenseItem[]
  drugReturns   DrugReturn[]

  @@index([organizationId])
  @@index([organizationId, expiryDate])
  @@index([organizationId, isActive])
  @@map("drugs")
}

/// One dispense order per prescription (`prescriptionId` unique) - tracks
/// the full fulfillment lifecycle of that prescription, the same
/// one-central-record-per-source-document idiom as `Encounter` per
/// consultation. See ADR-0014 for the status-machine design (partial vs.
/// complete dispense, reject vs. cancel, returned).
model DispenseOrder {
  id                String         @id @default(cuid())
  dispenseNumber    String
  prescriptionId    String         @unique
  patientId         String
  organizationId    String
  status            DispenseStatus @default(PENDING)
  preparedByUserId  String?
  dispensedByUserId String?
  dispensedAt       DateTime?
  /// Distinguishes a pharmacist-initiated reject from a requester cancel -
  /// both land on `CANCELLED` (see ADR-0014 point 5).
  rejected          Boolean        @default(false)
  cancelReason      String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  prescription Prescription   @relation(fields: [prescriptionId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  items        DispenseItem[]
  returns      DrugReturn[]

  @@unique([dispenseNumber, organizationId])
  @@index([organizationId, status])
  @@index([patientId, organizationId])
  @@map("dispense_orders")
}

/// Mirrors a `PrescriptionItem` 1:1 (`prescriptionItemId` unique),
/// denormalizing `medicationName` at creation time - same idiom as
/// `LabTestItem`/`RadiologyOrder`. `drugId` is null until the pharmacist
/// resolves the prescribed medication to a catalog batch ("Batch
/// selection" in the roadmap's frontend feature list).
model DispenseItem {
  id                 String   @id @default(cuid())
  dispenseOrderId    String
  prescriptionItemId String   @unique
  drugId             String?
  medicationName     String
  quantityRequested  Int
  quantityDispensed  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dispenseOrder    DispenseOrder    @relation(fields: [dispenseOrderId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  drug             Drug?            @relation(fields: [drugId], references: [id])
  drugReturns      DrugReturn[]

  @@index([dispenseOrderId])
  @@index([drugId])
  @@map("dispense_items")
}

/// A medicine return against an already-dispensed item - restocks
/// `Drug.currentStock` and moves the parent `DispenseOrder` to `RETURNED`
/// (see ADR-0014 point 5). Audited like every other pharmacy mutation.
model DrugReturn {
  id               String   @id @default(cuid())
  dispenseOrderId  String
  dispenseItemId   String
  drugId           String?
  organizationId   String
  quantityReturned Int
  reason           String
  returnedByUserId String
  returnedAt       DateTime @default(now())

  dispenseOrder DispenseOrder @relation(fields: [dispenseOrderId], references: [id])
  dispenseItem  DispenseItem  @relation(fields: [dispenseItemId], references: [id])
  drug          Drug?         @relation(fields: [drugId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([dispenseOrderId])
  @@index([organizationId])
  @@map("drug_returns")
}

// ─── General Inventory & Procurement (Milestone 13 / ADR-0020) ─────────────
//
// Replaces the unused `InventoryItem` scaffold (name/sku/category/
// quantityInStock/reorderLevel/reorderQuantity/unitCost/storageLocation -
// confirmed zero references anywhere before this milestone, same situation
// as `Medication` before ADR-0014 and `Ward`/`Bed`/`Admission` before
// ADR-0018) with a full multi-store item master, stock ledger, procurement
// lifecycle, vendor management, internal requisitions, asset management,
// and stock audit surface. This is explicitly the *general* hospital
// inventory system (wards/ICU/OT/labs/radiology/housekeeping/biomedical/
// central stores) - separate from `Drug`'s pharmacy-specific catalog
// (ADR-0014), which is untouched by this milestone.

enum InventoryItemType {
  ASSET
  CONSUMABLE
}

/// Two-level category hierarchy via self-relation (`parentId` null = a
/// top-level Category, non-null = a Subcategory of that category) rather
/// than a separate `InventorySubcategory` model - the two are structurally
/// identical (name/code/description/isActive) and Prisma's self-relation
/// models the hierarchy without a second near-duplicate table.
model InventoryCategory {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  parent       InventoryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     InventoryCategory[] @relation("CategoryHierarchy")
  items        InventoryItem[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([parentId])
  @@map("inventory_categories")
}

/// A cross-cutting classification independent of the category tree (e.g.
/// "Fast Moving", "Surgical", "High Value") - the roadmap lists this as a
/// distinct concept from Category/Subcategory, so it stays its own table
/// rather than folded into the category hierarchy.
model InventoryItemGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  items        InventoryItem[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("inventory_item_groups")
}

model InventoryUnit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  symbol         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  items        InventoryItem[]

  @@unique([symbol, organizationId])
  @@index([organizationId])
  @@map("inventory_units")
}

model InventoryManufacturer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  brands       InventoryBrand[]
  items        InventoryItem[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("inventory_manufacturers")
}

model InventoryBrand {
  id             String   @id @default(cuid())
  organizationId String
  manufacturerId String?
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  manufacturer InventoryManufacturer? @relation(fields: [manufacturerId], references: [id])
  items        InventoryItem[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("inventory_brands")
}

/// The item master. `hsnCode`/`gstPercent` are the GST-compliance fields;
/// `barcodeValue`/`qrCodeValue` hold the encoded string a scanner would
/// read (no image generation here - the frontend renders the code from the
/// value, same disclosed-scope idiom as every other placeholder in this
/// project). `trackBatch`/`trackSerial`/`trackExpiry` are per-item flags
/// the stock/batch layer honors rather than assuming every item behaves
/// like a drug batch (ADR-0014) - a biomedical asset tracks a serial
/// number and never expires; a bandage roll tracks neither.
model InventoryItem {
  id             String            @id @default(cuid())
  organizationId String
  categoryId     String?
  itemGroupId    String?
  unitId         String?
  manufacturerId String?
  brandId        String?
  name           String
  code           String
  description    String?
  itemType       InventoryItemType @default(CONSUMABLE)
  hsnCode        String?
  gstPercent     Decimal           @default(0) @db.Decimal(5, 2)
  barcodeValue   String?
  qrCodeValue    String?
  trackBatch     Boolean           @default(false)
  trackSerial    Boolean           @default(false)
  trackExpiry    Boolean           @default(false)
  unitCost       Decimal           @default(0) @db.Decimal(10, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization         Organization                 @relation(fields: [organizationId], references: [id])
  category             InventoryCategory?           @relation(fields: [categoryId], references: [id])
  itemGroup            InventoryItemGroup?          @relation(fields: [itemGroupId], references: [id])
  unit                 InventoryUnit?               @relation(fields: [unitId], references: [id])
  manufacturer         InventoryManufacturer?       @relation(fields: [manufacturerId], references: [id])
  brand                InventoryBrand?              @relation(fields: [brandId], references: [id])
  stocks               InventoryStock[]
  batches              InventoryBatch[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  requisitionItems     StoreRequisitionItem[]
  transferItems        InventoryStockTransferItem[]
  vendorReturnItems    VendorReturnItem[]
  stockAdjustments     InventoryStockAdjustment[]
  assets               Asset[]
  stockAuditItems      StockAuditItem[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([organizationId, itemType])
  @@index([organizationId, isActive])
  @@map("inventory_items")
}

enum InventoryStoreType {
  CENTRAL
  WARD
  ICU
  EMERGENCY
  OT
  LABORATORY
  RADIOLOGY
  PHARMACY
  HOUSEKEEPING
  BIOMEDICAL
  GENERAL
}

model InventoryStore {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  code           String
  type           InventoryStoreType @default(GENERAL)
  location       String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id])
  managers          InventoryStoreManager[]
  stocks            InventoryStock[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  vendorReturns     VendorReturn[]
  requisitionsFrom  StoreRequisition[]       @relation("RequisitionFromStore")
  requisitionsTo    StoreRequisition[]       @relation("RequisitionToStore")
  transfersFrom     InventoryStockTransfer[] @relation("TransferFromStore")
  transfersTo       InventoryStockTransfer[] @relation("TransferToStore")
  assets            Asset[]
  assetAssignments  AssetAssignment[]
  stockAudits       StockAudit[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("inventory_stores")
}

enum StoreManagerRole {
  MANAGER
  STAFF
}

model InventoryStoreManager {
  id               String           @id @default(cuid())
  organizationId   String
  storeId          String
  userId           String
  role             StoreManagerRole @default(STAFF)
  assignedByUserId String
  assignedAt       DateTime         @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  store        InventoryStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([organizationId])
  @@map("inventory_store_managers")
}

model Vendor {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  code              String
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstin             String?
  pan               String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  paymentTermsDays  Int      @default(30)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id])
  ratings           VendorRating[]
  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  vendorInvoices    VendorInvoice[]
  vendorReturns     VendorReturn[]
  assetAmcRecords   AssetMaintenanceRecord[]
  Asset             Asset[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("vendors")
}

/// Standalone rating events rather than a single mutable field on `Vendor`
/// - preserves rating history; a vendor's current/average rating is
/// computed at read time from these rows (same "don't denormalize
/// something that changes often" reasoning that kept billing/insurance
/// totals computed rather than cached where they'd go stale).
model VendorRating {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  rating         Int
  comments       String?
  ratedByUserId  String
  ratedAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([organizationId])
  @@map("vendor_ratings")
}

/// One row per (item, store) - the current stock summary. `availableStock`
/// is deliberately not a stored column: it's `currentStock - reservedStock
/// - damagedStock - expiredStock - lostStock`, computed at read time so it
/// can never drift out of sync with the components it's derived from.
model InventoryStock {
  id               String    @id @default(cuid())
  organizationId   String
  itemId           String
  storeId          String
  currentStock     Int       @default(0)
  reservedStock    Int       @default(0)
  damagedStock     Int       @default(0)
  expiredStock     Int       @default(0)
  lostStock        Int       @default(0)
  reorderLevel     Int       @default(0)
  minStock         Int       @default(0)
  maxStock         Int       @default(0)
  openingStock     Int       @default(0)
  openingStockDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  item         InventoryItem    @relation(fields: [itemId], references: [id])
  store        InventoryStore   @relation(fields: [storeId], references: [id])
  batches      InventoryBatch[]

  @@unique([itemId, storeId])
  @@index([organizationId])
  @@index([organizationId, storeId])
  @@map("inventory_stocks")
}

enum InventoryBatchStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  EXPIRED
  LOST
  CONSUMED
}

/// Per-batch/serial breakdown of an `InventoryStock` row, populated only
/// for items with `trackBatch`/`trackSerial`/`trackExpiry` set - an item
/// without any of those flags is tracked purely at the `InventoryStock`
/// aggregate level with no batch rows at all.
model InventoryBatch {
  id               String               @id @default(cuid())
  organizationId   String
  itemId           String
  storeId          String
  inventoryStockId String
  batchNumber      String?
  serialNumber     String?
  manufactureDate  DateTime?
  expiryDate       DateTime?
  quantity         Int                  @default(0)
  status           InventoryBatchStatus @default(AVAILABLE)
  receivedAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization      Organization                 @relation(fields: [organizationId], references: [id])
  item              InventoryItem                @relation(fields: [itemId], references: [id])
  inventoryStock    InventoryStock               @relation(fields: [inventoryStockId], references: [id], onDelete: Cascade)
  goodsReceiptItems GoodsReceiptItem[]
  requisitionItems  StoreRequisitionItem[]
  transferItems     InventoryStockTransferItem[]
  vendorReturnItems VendorReturnItem[]
  stockAdjustments  InventoryStockAdjustment[]
  stockAuditItems   StockAuditItem[]

  @@index([organizationId])
  @@index([itemId, storeId])
  @@index([organizationId, expiryDate])
  @@map("inventory_batches")
}

enum InventoryAdjustmentType {
  OPENING
  DAMAGE
  LOSS
  EXPIRY
  CORRECTION
  AUDIT
  ISSUE
  RECEIPT
  TRANSFER
}

/// An append-only ledger of every stock movement/correction - the single
/// source of truth for "why did this number change," mirroring the
/// audit-trail idiom every other module in this project already uses for
/// its own domain (e.g. `BedTransfer`/`BedAllocation` for beds).
model InventoryStockAdjustment {
  id               String                  @id @default(cuid())
  organizationId   String
  itemId           String
  storeId          String
  batchId          String?
  type             InventoryAdjustmentType
  quantityDelta    Int
  reason           String?
  referenceType    String?
  referenceId      String?
  adjustedByUserId String
  adjustedAt       DateTime                @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  item         InventoryItem   @relation(fields: [itemId], references: [id])
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([organizationId, storeId])
  @@index([itemId])
  @@map("inventory_stock_adjustments")
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// A direct store-to-store stock movement, distinct from `StoreRequisition`
/// - a transfer is supply-initiated (e.g. Central proactively rebalancing
/// stock into ICU Store) with no approval step, while a requisition is
/// demand-initiated by the requesting store and needs approval.
model InventoryStockTransfer {
  id                 String              @id @default(cuid())
