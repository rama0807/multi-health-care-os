// ─── Core Tenant Model ─────────────────────────────────────────────────────

model Organization {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  type                  OrganizationType @default(HOSPITAL)
  email                 String
  phone                 String
  address               String?
  city                  String?
  state                 String?
  country               String           @default("IN")
  pincode               String?
  logo                  String?
  website               String?
  licenseNumber         String?
  taxId                 String?
  settings              Json             @default("{}")
  subscriptionTier      SubscriptionTier @default(FREE)
  subscriptionExpiresAt DateTime?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  users                 User[]
  roles                 Role[]
  hospitals             Hospital[]
  departments           Department[]
  doctors               Doctor[]
  patients              Patient[]
  appointments          Appointment[]
  encounters            Encounter[]
  labTests              LabTest[]
  labTestCatalogItems   LabTestCatalogItem[]
  radiologyOrders       RadiologyOrder[]
  radiologyCatalogItems RadiologyCatalogItem[]
  invoices              Invoice[]
  serviceCatalogItems   ServiceCatalogItem[]
  charges               Charge[]
  refunds               Refund[]
  staff                 Staff[]
  beds                  Bed[]
  wards                 Ward[]
  drugs                 Drug[]
  dispenseOrders        DispenseOrder[]
  drugReturns           DrugReturn[]
  inventoryItems        InventoryItem[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  prescriptions         Prescription[]
  admissions            Admission[]
  insuranceClaims       InsuranceClaim[]
  doctorSchedules       DoctorSchedule[]
  doctorLeaves          DoctorLeave[]

  @@index([slug])
  @@map("organizations")
}

// ─── Identity & Access ─────────────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatar              String?
  status              UserStatus @default(PENDING_VERIFICATION)
  isEmailVerified     Boolean    @default(false)
  timezone            String     @default("Asia/Kolkata")
  mfaEnabled          Boolean    @default(false)
  mfaSecret           String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  organizationId      String
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  userRoles     UserRole[]
  doctorProfile Doctor?
  staffProfile  Staff?
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id             String      @id @default(cuid())
  name           String
  description    String?
  systemRole     SystemRole?
  organizationId String
  createdAt      DateTime    @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  scope       String  @default("all")
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  hospitalId String?
  assignedAt DateTime @default(now())
  assignedBy String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([hospitalId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Organization Structure ────────────────────────────────────────────────

model Hospital {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String   @default("IN")
  pincode        String?
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  departments  Department[]
  userRoles    UserRole[]
  doctors      Doctor[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("hospitals")
}

model Department {
  id             String   @id @default(cuid())
  name           String
  code           String
  description    String?
  headDoctorId   String?
  hospitalId     String
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  doctors      Doctor[]
  staff        Staff[]
  wards        Ward[]
  appointments Appointment[]

  @@unique([code, hospitalId])
  @@index([organizationId])
  @@index([hospitalId])
  @@map("departments")
}

model Doctor {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  registrationNumber String
  specialization     String
  subSpecialization  String?
  qualification      String
  experienceYears    Int                      @default(0)
  languagesSpoken    String[]                 @default([])
  departmentId       String?
  hospitalId         String
  organizationId     String
  consultationFee    Decimal                  @db.Decimal(10, 2)
  availabilityStatus DoctorAvailabilityStatus @default(AVAILABLE)
  joiningDate        DateTime
  bio                String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  hospital        Hospital         @relation(fields: [hospitalId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  radiologyOrders RadiologyOrder[]
  schedules       DoctorSchedule[]
  leaves          DoctorLeave[]
  documents       DoctorDocument[]

  @@unique([registrationNumber, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([hospitalId])
  @@map("doctors")
}

// ─── Provider Scheduling ───────────────────────────────────────────────────
//
// Modeled per-provider-type (Doctor) rather than through a polymorphic
// "Provider" table — see ADR-0006. The *algorithm* in AvailabilityService
// (weekly schedule + leave overlay + shift/break slot slicing) is written
// generically enough that a future provider type (Nurse, Physiotherapist,
// etc.) can stand up its own {Type}Schedule/{Type}ScheduleDay/{Type}Leave
// trio and near-identical service without redesigning the approach.

model DoctorSchedule {
  id             String   @id @default(cuid())
  doctorId       String
  organizationId String
  // The date this version takes effect from. Selecting "the schedule that
  // applies on date X" = the isActive row with the greatest effectiveFrom
  // that is <= X — this lets a new version be created ahead of time
  // (effectiveFrom in the future) without disturbing what's currently in
  // effect, and keeps every prior version in place for history/audit
  // instead of overwriting it in place.
  effectiveFrom  DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id])
  days         DoctorScheduleDay[]

  @@unique([doctorId, effectiveFrom])
  @@index([doctorId])
  @@index([organizationId])
  @@index([doctorId, isActive, effectiveFrom])
  @@map("doctor_schedules")
}

model DoctorScheduleDay {
  id           String   @id @default(cuid())
  scheduleId   String
  dayOfWeek    Weekday
  isWorkingDay Boolean  @default(true)
  // ScheduleShift[] — see packages/types/src/doctor-schedule.ts. Kept as JSON
  // (like Doctor.languagesSpoken/Organization.settings elsewhere in this
  // schema) since a day's shifts+breaks are always read/written together as
  // one unit from the schedule editor, never queried independently.
  shifts       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedule DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
  @@map("doctor_schedule_days")
}

model DoctorLeave {
  id              String      @id @default(cuid())
  doctorId        String
  organizationId  String
  leaveType       LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  reason          String?
  status          LeaveStatus @default(PENDING)
  appliedByUserId String
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([doctorId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([doctorId, startDate, endDate])
  @@map("doctor_leaves")
}

enum DoctorDocumentType {
  MEDICAL_DEGREE
  MEDICAL_LICENSE
  EXPERIENCE_CERTIFICATE
  ID_PROOF
  OTHER
}

model DoctorDocument {
  id             String             @id @default(cuid())
  doctorId       String
  organizationId String
  documentType   DoctorDocumentType
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime           @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_documents")
}

model Staff {
  id             String    @id @default(cuid())
  userId         String    @unique
  employeeId     String
  designation    String
  departmentId   String?
  organizationId String
  shiftType      ShiftType @default(MORNING)
  joiningDate    DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([employeeId, organizationId])
  @@index([organizationId])
  @@map("staff")
}

// ─── Patient ───────────────────────────────────────────────────────────────

model Patient {
  id                    String      @id @default(cuid())
  uhid                  String
  firstName             String
  lastName              String
  email                 String?
  phone                 String
  dateOfBirth           DateTime
  gender                Gender
  bloodGroup            BloodGroup?
  address               String?
  city                  String?
  state                 String?
  country               String      @default("IN")
  pincode               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  organizationId        String
  metadata              Json        @default("{}")
  isActive              Boolean     @default(true)
  deletedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  documents       PatientDocument[]
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  radiologyOrders RadiologyOrder[]
  invoices        Invoice[]
  admissions      Admission[]
  insuranceClaims InsuranceClaim[]
  notifications   Notification[]
  dispenseOrders  DispenseOrder[]

  @@unique([uhid, organizationId])
  @@unique([phone, organizationId])
  @@index([organizationId])
  @@index([uhid])
  @@index([phone])
  @@map("patients")
}

model PatientDocument {
  id             String       @id @default(cuid())
  patientId      String
  organizationId String
  documentType   DocumentType
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime     @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_documents")
}

// ─── Appointments ──────────────────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String
  patientId         String
  doctorId          String
  departmentId      String?
  organizationId    String
  scheduledAt       DateTime
  durationMinutes   Int               @default(15)
  type              AppointmentType   @default(OPD)
  status            AppointmentStatus @default(SCHEDULED)
  chiefComplaint    String?
  notes             String?
  roomNumber        String?
  referredBy        String?
  // `isWalkIn`/`recurrenceGroupId` — see ADR-0007. A walk-in still has a
  // real `scheduledAt` (the receptionist assigns the next available slot
  // automatically); the flag only distinguishes how it was booked, for
  // reporting/queue-display purposes. `recurrenceGroupId` links every
  // occurrence created from one recurring-booking request — null for a
  // one-off appointment.
  isWalkIn          Boolean           @default(false)
  recurrenceGroupId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  encounter    Encounter?
  labTests     LabTest[]
  invoice      Invoice?
  charges      Charge[]

  @@unique([appointmentNumber, organizationId])
  @@index([organizationId])
  @@index([doctorId, scheduledAt])
  @@index([patientId, organizationId])
  @@index([status, organizationId, scheduledAt])
  @@index([recurrenceGroupId])
  @@map("appointments")
}

// ─── Clinical — EMR (see ADR-0008) ─────────────────────────────────────────
//
// `Encounter` is the longitudinal EMR's central entity — one per
// consultation, created from a completed `Appointment`. Everything a
// clinician records during that consultation hangs off it as its own
// child table (`ClinicalNote`, `Vital`, `Diagnosis`, `Procedure`,
// `EncounterAttachment`) rather than being flat columns on `Encounter`
// itself, so each facet can evolve/be queried independently — most
// importantly `ClinicalNote`, which is append-only (see its own comment).

enum EncounterType {
  OPD
  TELECONSULTATION
  FOLLOW_UP
  EMERGENCY
  WALK_IN
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  AMENDED
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

model Encounter {
  id             String          @id @default(cuid())
  patientId      String
  doctorId       String
  appointmentId  String?         @unique
  organizationId String
  type           EncounterType   @default(OPD)
  status         EncounterStatus @default(IN_PROGRESS)
  notes          String?
  encounterDate  DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient         Patient               @relation(fields: [patientId], references: [id])
  doctor          Doctor                @relation(fields: [doctorId], references: [id])
  appointment     Appointment?          @relation(fields: [appointmentId], references: [id])
  organization    Organization          @relation(fields: [organizationId], references: [id])
  clinicalNotes   ClinicalNote[]
  vitals          Vital[]
  diagnoses       Diagnosis[]
  procedures      Procedure[]
  attachments     EncounterAttachment[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  radiologyOrders RadiologyOrder[]
  invoice         Invoice?
  charges         Charge[]

  @@index([patientId, organizationId])
  @@index([doctorId, organizationId])
  @@index([organizationId])
  @@map("encounters")
}

/// Append-only: an edit inserts a new row with `version = previous + 1`
/// rather than updating in place — "never overwrite historical notes" is
/// enforced by never exposing an `update` at the service layer, not just
/// by convention. The current note is the highest `version` per encounter.
model ClinicalNote {
  id                      String   @id @default(cuid())
  encounterId             String
  version                 Int
  chiefComplaint          String?
  historyOfPresentIllness String?
  pastMedicalHistory      String?
  familyHistory           String?
  surgicalHistory         String?
  socialHistory           String?
  allergies               String?
  currentMedications      String?
  createdByUserId         String
  createdAt               DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@unique([encounterId, version])
  @@index([encounterId])
  @@map("clinical_notes")
}

model Vital {
  id                     String   @id @default(cuid())
  encounterId            String
  heightCm               Float?
  weightKg               Float?
  /// Computed server-side from height/weight at write time — denormalized
  /// so trend/chart queries don't recompute float math per row.
  bmi                    Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulse                  Int?
  temperatureCelsius     Float?
  respiratoryRate        Int?
  spo2                   Int?
  recordedByUserId       String
  recordedAt             DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("vitals")
}

model Diagnosis {
  id          String        @id @default(cuid())
  encounterId String
  type        DiagnosisType @default(PRIMARY)
  description String
  /// Placeholder, not a validated lookup against a real ICD-10 terminology
  /// service — see ADR-0008/TECH_DEBT.
  icdCode     String?
  createdAt   DateTime      @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("diagnoses")
}

model Procedure {
  id          String   @id @default(cuid())
  encounterId String
  name        String
  notes       String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("procedures")
}

enum EncounterAttachmentType {
  CLINICAL_DOCUMENT
  IMAGE
  EXTERNAL_REPORT
  OTHER
}

model EncounterAttachment {
  id             String                  @id @default(cuid())
  encounterId    String
  organizationId String
  documentType   EncounterAttachmentType @default(OTHER)
  fileName       String
  fileUrl        String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime                @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("encounter_attachments")
}

model Prescription {
  id                 String             @id @default(cuid())
  prescriptionNumber String
  patientId          String
  doctorId           String
  encounterId        String?
  organizationId     String
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  prescribedAt       DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  patient       Patient            @relation(fields: [patientId], references: [id])
  doctor        Doctor             @relation(fields: [doctorId], references: [id])
  encounter     Encounter?         @relation(fields: [encounterId], references: [id])
  organization  Organization       @relation(fields: [organizationId], references: [id])
  items         PrescriptionItem[]
  dispenseOrder DispenseOrder?

  @@unique([prescriptionNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  medicationName String
  genericName    String?
  strength       String?
  form           String?
  dosage         String
  frequency      String
  duration       String
  route          String   @default("ORAL")
  instructions   String?
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  prescription Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  dispenseItem DispenseItem?

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ─── Laboratory ────────────────────────────────────────────────────────────

/// Org-scoped, configurable catalog of orderable lab tests — see ADR-0012.
/// Supports both a numeric reference range (`referenceRangeLow`/`High`, used
/// for automatic abnormal-value flagging) and a free-text range (for
/// qualitative tests like "Negative"/"Non-reactive" where a numeric bound
/// makes no sense) — either or both may be set. `criticalLow`/`criticalHigh`
/// are optional explicit critical thresholds; when absent, callers fall back
/// to a documented multiplier of the normal range (see `abnormal-flagging.ts`).
model LabTestCatalogItem {
  id                 String   @id @default(cuid())
  organizationId     String
  testCode           String
  testName           String
  category           String
  unit               String?
  referenceRangeLow  Float?
  referenceRangeHigh Float?
  referenceRangeText String?
  criticalLow        Float?
  criticalHigh       Float?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        LabTestItem[]

  @@unique([organizationId, testCode])
  @@index([organizationId])
  @@map("lab_test_catalog_items")
}

model LabTest {
  id                String        @id @default(cuid())
  labOrderNumber    String
  patientId         String
  doctorId          String
  appointmentId     String?
  encounterId       String?
  organizationId    String
  status            LabTestStatus @default(ORDERED)
  priority          Priority      @default(ROUTINE)
  sampleCollectedBy String?
  sampleCollectedAt DateTime?
  reportedAt        DateTime?
  reportFileUrl     String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  encounter    Encounter?    @relation(fields: [encounterId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  items        LabTestItem[]

  @@unique([labOrderNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([encounterId])
  @@map("lab_tests")
}

model LabTestItem {
  id                 String        @id @default(cuid())
  labTestId          String
  catalogItemId      String?
  testName           String
  testCode           String
  category           String
  result             String?
  unit               String?
  referenceRange     String?
  /// Denormalized from the catalog item (or explicit ad-hoc bounds) at order
  /// time, not looked up again at result-entry time — so a later edit or
  /// deactivation of the catalog item never changes how an already-ordered
  /// item's abnormal flag is computed. See `abnormal-flagging.ts`.
  referenceRangeLow  Float?
  referenceRangeHigh Float?
  criticalLow        Float?
  criticalHigh       Float?
  isAbnormal         Boolean       @default(false)
  abnormalType       AbnormalType?
  interpretation     String?
  createdAt          DateTime      @default(now())

  labTest     LabTest             @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  catalogItem LabTestCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([labTestId])
  @@index([catalogItemId])
  @@map("lab_test_items")
}

// ─── Radiology ─────────────────────────────────────────────────────────────

/// Org-configurable catalog of orderable radiology studies (Milestone 8,
/// mirrors LabTestCatalogItem's shape/role — ADR-0013). `modality`/`bodyPart`
/// stay free-text `String` (not enums), matching the pre-existing
/// `RadiologyOrder.modality`/`bodyPart` columns from the original scaffold —
/// real-world modality vocabularies (DICOM's CR/CT/MR/US/MG/NM/PT/XA/...)
/// are broad and this keeps the door open for a future PACS integration to
/// supply its own values without a schema change.
model RadiologyCatalogItem {
  id                       String   @id @default(cuid())
  organizationId           String
  code                     String
  name                     String
  category                 String
  modality                 String
  bodyPart                 String
  contrastRequired         Boolean  @default(false)
  price                    Decimal  @db.Decimal(10, 2)
  estimatedDurationMinutes Int
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  orders       RadiologyOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("radiology_catalog_items")
}

model RadiologyOrder {
  id                 String          @id @default(cuid())
  orderNumber        String
  patientId          String
  doctorId           String
  encounterId        String?
  catalogItemId      String?
  organizationId     String
  modality           String
  bodyPart           String
  clinicalIndication String?
  status             RadiologyStatus @default(ORDERED)
  priority           Priority        @default(ROUTINE)

  // Scheduling — appointment date/time, room, machine, and staff assignment.
  // `technicianUserId` stays a plain String (no FK), matching the existing
  // "actor" convention (ADR-0008 point 5, e.g. LabTest.sampleCollectedBy) —
  // there is no dedicated RadiologyTechnician profile model, just a User
  // with the RADIOLOGY_TECHNICIAN system role. `radiologistDoctorId` is a
  // real FK to Doctor since a radiologist is a Doctor profile (by
  // specialization), the same reuse `LabTest.doctorId` already relies on.
  scheduledAt         DateTime?
  room                String?
  machine             String?
  technicianUserId    String?
  radiologistDoctorId String?
  durationMinutes     Int?

  // Report — current/released snapshot, denormalized from the latest
  // RadiologyReport version below for cheap reads (list/queue views) without
  // an extra join; the versioned history itself lives in `reports`.
  technique        String?
  findings         String?
  impression       String?
  recommendations  String?
  reportFileUrl    String?
  reportedBy       String?
  reportedAt       DateTime?
  verifiedByUserId String?
  verifiedAt       DateTime?
  releasedByUserId String?
  releasedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      Patient               @relation(fields: [patientId], references: [id])
  doctor       Doctor                @relation(fields: [doctorId], references: [id])
  encounter    Encounter?            @relation(fields: [encounterId], references: [id])
  catalogItem  RadiologyCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  organization Organization          @relation(fields: [organizationId], references: [id])
  reports      RadiologyReport[]
  attachments  RadiologyAttachment[]

  @@unique([orderNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@index([status, organizationId])
  @@index([encounterId])
  @@map("radiology_orders")
}

/// Append-only, versioned radiology report — same "never overwrite" pattern
/// as `ClinicalNote` (ADR-0008): an edit inserts a new row with
/// `version = previous + 1` rather than updating in place. The current
/// (highest-version) row's content is denormalized onto `RadiologyOrder`
/// itself for cheap reads; verification/release act on that current version.
model RadiologyReport {
  id                 String   @id @default(cuid())
  radiologyOrderId   String
  version            Int
  clinicalIndication String?
  technique          String?
  findings           String?
  impression         String?
  recommendations    String?
  createdByUserId    String?
  createdAt          DateTime @default(now())

  radiologyOrder RadiologyOrder @relation(fields: [radiologyOrderId], references: [id], onDelete: Cascade)

  @@index([radiologyOrderId])
  @@map("radiology_reports")
}

/// Image/document attachments for a radiology order. `EXTERNAL_IMAGING` and
/// `DICOM_PLACEHOLDER` support a study referenced from an outside PACS/imaging
/// center without a real file (metadata-only — accession number, external
/// URL, study instance UID placeholder); `IMAGE`/`PDF` require a real
/// uploaded file via the existing `StorageService`. No real PACS/DICOM server
/// integration exists — see TECH_DEBT.
model RadiologyAttachment {
  id               String                  @id @default(cuid())
  radiologyOrderId String
  organizationId   String
  type             RadiologyAttachmentType @default(OTHER)
  fileName         String?
  fileUrl          String?
  mimeType         String?
  fileSizeBytes    Int?
  metadata         Json?
  uploadedByUserId String?
  uploadedAt       DateTime                @default(now())

  radiologyOrder RadiologyOrder @relation(fields: [radiologyOrderId], references: [id], onDelete: Cascade)

  @@index([radiologyOrderId])
  @@map("radiology_attachments")
}

// ─── Inpatient ─────────────────────────────────────────────────────────────

model Ward {
  id             String   @id @default(cuid())
  name           String
  code           String
  departmentId   String?
  organizationId String
  totalBeds      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  beds         Bed[]
  admissions   Admission[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@map("wards")
}

model Bed {
  id             String    @id @default(cuid())
  bedNumber      String
  wardId         String
  organizationId String
  type           BedType   @default(GENERAL)
  status         BedStatus @default(AVAILABLE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ward         Ward         @relation(fields: [wardId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  admissions   Admission[]

  @@unique([bedNumber, wardId])
  @@index([organizationId])
  @@index([wardId, status])
  @@map("beds")
}

model Admission {
  id                 String          @id @default(cuid())
  admissionNumber    String
  patientId          String
  doctorId           String?
  bedId              String?
  wardId             String?
  organizationId     String
  status             AdmissionStatus @default(ADMITTED)
  admissionReason    String
  diagnosis          String?
  admittedAt         DateTime        @default(now())
  dischargedAt       DateTime?
  dischargeNotes     String?
  dischargeCondition String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  bed          Bed?         @relation(fields: [bedId], references: [id])
  ward         Ward?        @relation(fields: [wardId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([admissionNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([organizationId])
  @@map("admissions")
}

// ─── Billing ───────────────────────────────────────────────────────────────

model Invoice {
  id                        String                 @id @default(cuid())
  invoiceNumber             String
  patientId                 String
  appointmentId             String?                @unique
  encounterId               String?                @unique
  organizationId            String
  status                    InvoiceStatus          @default(DRAFT)
  type                      InvoiceType            @default(OPD)
  subtotal                  Decimal                @db.Decimal(12, 2)
  discountAmount            Decimal                @default(0) @db.Decimal(12, 2)
  taxAmount                 Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount               Decimal                @db.Decimal(12, 2)
  paidAmount                Decimal                @default(0) @db.Decimal(12, 2)
  balanceDue                Decimal                @db.Decimal(12, 2)
  currency                  String                 @default("INR")
  notes                     String?
  dueDate                   DateTime?
  createdByUserId           String?
  // Discount workflow — see ADR-0015. A discount applied by a `billing.manage`
  // scope holder is auto-approved; anyone else's request lands `PENDING`
  // until a manage-scope holder approves/rejects it. Only an `APPROVED`
  // discount is ever reflected in `discountAmount`/`totalAmount`/`balanceDue`.
  discountType              DiscountType?
  discountValue             Decimal?               @db.Decimal(10, 2)
  discountReason            String?
  discountApprovalStatus    DiscountApprovalStatus @default(NONE)
  discountRequestedByUserId String?
  discountApprovedByUserId  String?
  discountApprovedAt        DateTime?
  finalizedAt               DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  encounter      Encounter?      @relation(fields: [encounterId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  refunds        Refund[]
  charges        Charge[]
  insuranceClaim InsuranceClaim?

  @@unique([invoiceNumber, organizationId])
  @@index([patientId, organizationId])
  @@index([status, organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  itemName        String
  itemCode        String?
  category        String
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String
  invoiceId       String
  patientId       String
  organizationId  String
  amount          Decimal       @db.Decimal(12, 2)
  paymentMode     PaymentMode
  transactionId   String?
  referenceNumber String?
  status          PaymentStatus @default(COMPLETED)
  collectedBy     String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  refunds Refund[]

  @@unique([paymentNumber, organizationId])
  @@index([invoiceId])
  @@index([patientId, organizationId])
  @@map("payments")
}

model InsuranceClaim {
  id                String               @id @default(cuid())
  claimNumber       String
  patientId         String
  invoiceId         String               @unique
  organizationId    String
  insuranceProvider String
  policyNumber      String
  membershipId      String?
  claimedAmount     Decimal              @db.Decimal(12, 2)
  approvedAmount    Decimal?             @db.Decimal(12, 2)
  rejectedAmount    Decimal?             @db.Decimal(12, 2)
  status            InsuranceClaimStatus @default(DRAFT)
  rejectionReason   String?
  submittedAt       DateTime?
  settledAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([claimNumber, organizationId])
  @@index([patientId, organizationId])
  @@map("insurance_claims")
}

/// Configurable pricing catalog ("service catalog with pricing") — see
/// ADR-0015. `category` stays free-text (mirrors `RadiologyCatalogItem
/// .modality`/`bodyPart`'s precedent) rather than an enum, since billable
/// service categories vary per organization. `taxPercent` defaults from
/// `Organization.settings.gstRate` at creation time, editable per item.
model ServiceCatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  category       String
  price          Decimal  @db.Decimal(10, 2)
  taxPercent     Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  charges      Charge[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("service_catalog_items")
}

/// The reusable Charge Engine entity — see ADR-0015. Every clinical module
/// (or a manual cashier action) creates one `Charge` row; invoice generation
/// (auto from a completed appointment, or manual) sweeps every `PENDING`
/// charge for a patient/encounter into `InvoiceItem` rows and flips them to
/// `INVOICED`. Denormalizes `description`/`unitPrice`/`taxPercent` at
/// creation time (from the catalog item or ad-hoc) — the same "denormalize
/// at order time" idiom as `LabTestItem`/`RadiologyOrder`/`DispenseItem`, so
/// a later catalog edit never retroactively changes an already-billed charge.
model Charge {
  id              String             @id @default(cuid())
  organizationId  String
  patientId       String
  encounterId     String?
  appointmentId   String?
  sourceModule    ChargeSourceModule @default(MISCELLANEOUS)
  sourceId        String?
  catalogItemId   String?
  description     String
  quantity        Int                @default(1)
  unitPrice       Decimal            @db.Decimal(10, 2)
  discountPercent Decimal            @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal            @default(0) @db.Decimal(10, 2)
  taxPercent      Decimal            @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal            @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  status          ChargeStatus       @default(PENDING)
  invoiceId       String?
  createdByUserId String?
  createdAt       DateTime           @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  encounter    Encounter?          @relation(fields: [encounterId], references: [id])
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id])
  catalogItem  ServiceCatalogItem? @relation(fields: [catalogItemId], references: [id])
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, patientId])
  @@index([status, organizationId])
  @@index([encounterId])
  @@index([appointmentId])
  @@map("charges")
}

/// Partial or full refund against a `Payment`/`Invoice` — see ADR-0015. A
/// `billing.manage` scope holder's request is auto-approved+completed;
/// anyone else's lands `PENDING` until a manage-scope holder approves it —
/// the same approval-workflow shape as `Invoice`'s discount fields.
model Refund {
  id                String       @id @default(cuid())
  refundNumber      String
  organizationId    String
  invoiceId         String
  paymentId         String?
  amount            Decimal      @db.Decimal(12, 2)
  reason            String
  refundMode        PaymentMode?
  status            RefundStatus @default(PENDING)
  requestedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  refundedAt        DateTime?
  createdAt         DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@unique([refundNumber, organizationId])
  @@index([invoiceId])
  @@index([organizationId, status])
  @@map("refunds")
}

// ─── Pharmacy & Inventory ──────────────────────────────────────────────────

// ─── Pharmacy ───────────────────────────────────────────────────────────────

enum DispenseStatus {
  PENDING
  PREPARING
  READY
  DISPENSED
  CANCELLED
  RETURNED
}

/// Org-scoped pharmacy catalog — see ADR-0014. One row is one batch of a
/// drug: batch number and expiry are first-class catalog fields (per the
/// roadmap's own "Drug Catalog CRUD Fields" list), not a separate child
/// table — restocking the same generic/brand drug with a new batch creates
/// a new `Drug` row rather than a join. Replaces the unused `Medication`
/// model from the original scaffolding commit (confirmed zero references
/// anywhere before this milestone), whose shape was missing brand name,
/// batch, expiry, tax, and stock-level fields.
model Drug {
  id             String   @id @default(cuid())
  organizationId String
  genericName    String
  brandName      String?
  strength       String?
  dosageForm     String
  manufacturer   String?
  batchNumber    String
  expiryDate     DateTime
  price          Decimal  @default(0) @db.Decimal(10, 2)
  taxPercent     Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  /// Physical quantity on hand, including any reserved portion.
  currentStock   Int      @default(0)
  /// Portion of `currentStock` earmarked by an in-progress `DispenseOrder`
  /// (status `PREPARING`/`READY`) — not yet deducted. See ADR-0014 point 6.
  reservedStock  Int      @default(0)
  minStockLevel  Int      @default(10)
  reorderLevel   Int      @default(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  dispenseItems DispenseItem[]
  drugReturns   DrugReturn[]

  @@index([organizationId])
  @@index([organizationId, expiryDate])
  @@index([organizationId, isActive])
  @@map("drugs")
}

/// One dispense order per prescription (`prescriptionId` unique) — tracks
/// the full fulfillment lifecycle of that prescription, the same
/// one-central-record-per-source-document idiom as `Encounter` per
/// consultation. See ADR-0014 for the status-machine design (partial vs.
/// complete dispense, reject vs. cancel, returned).
model DispenseOrder {
  id                String         @id @default(cuid())
  dispenseNumber    String
  prescriptionId    String         @unique
  patientId         String
  organizationId    String
  status            DispenseStatus @default(PENDING)
  preparedByUserId  String?
  dispensedByUserId String?
  dispensedAt       DateTime?
  /// Distinguishes a pharmacist-initiated reject from a requester cancel —
  /// both land on `CANCELLED` (see ADR-0014 point 5).
  rejected          Boolean        @default(false)
  cancelReason      String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  prescription Prescription   @relation(fields: [prescriptionId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  items        DispenseItem[]
  returns      DrugReturn[]

  @@unique([dispenseNumber, organizationId])
  @@index([organizationId, status])
  @@index([patientId, organizationId])
  @@map("dispense_orders")
}

/// Mirrors a `PrescriptionItem` 1:1 (`prescriptionItemId` unique),
/// denormalizing `medicationName` at creation time — same idiom as
/// `LabTestItem`/`RadiologyOrder`. `drugId` is null until the pharmacist
/// resolves the prescribed medication to a catalog batch ("Batch
/// selection" in the roadmap's frontend feature list).
model DispenseItem {
  id                 String   @id @default(cuid())
  dispenseOrderId    String
  prescriptionItemId String   @unique
  drugId             String?
  medicationName     String
  quantityRequested  Int
  quantityDispensed  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dispenseOrder    DispenseOrder    @relation(fields: [dispenseOrderId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  drug             Drug?            @relation(fields: [drugId], references: [id])
  drugReturns      DrugReturn[]

  @@index([dispenseOrderId])
  @@index([drugId])
  @@map("dispense_items")
}

/// A medicine return against an already-dispensed item — restocks
/// `Drug.currentStock` and moves the parent `DispenseOrder` to `RETURNED`
/// (see ADR-0014 point 5). Audited like every other pharmacy mutation.
model DrugReturn {
  id               String   @id @default(cuid())
  dispenseOrderId  String
  dispenseItemId   String
  drugId           String?
  organizationId   String
  quantityReturned Int
  reason           String
  returnedByUserId String
  returnedAt       DateTime @default(now())

  dispenseOrder DispenseOrder @relation(fields: [dispenseOrderId], references: [id])
  dispenseItem  DispenseItem  @relation(fields: [dispenseItemId], references: [id])
  drug          Drug?         @relation(fields: [drugId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([dispenseOrderId])
  @@index([organizationId])
  @@map("drug_returns")
}

model InventoryItem {
  id              String   @id @default(cuid())
  name            String
  sku             String
  category        String
  organizationId  String
  quantityInStock Int      @default(0)
  reorderLevel    Int      @default(10)
  reorderQuantity Int      @default(50)
  unitCost        Decimal  @default(0) @db.Decimal(10, 2)
  storageLocation String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([sku, organizationId])
  @@index([organizationId])
  @@map("inventory_items")
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String?
  patientId      String?
  type           NotificationType
  title          String
  body           String
  data           Json                @default("{}")
  isRead         Boolean             @default(false)
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(PENDING)
  failureReason  String?
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])

  @@index([organizationId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Audit ─────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([resource, resourceId, organizationId])
  @@index([userId, organizationId])
  @@map("audit_logs")
}
