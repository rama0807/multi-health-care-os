enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  INSURANCE_CARD
  MEDICAL_REPORT
  PRESCRIPTION
  OTHER
